static lv_indev_t *pointer;
static lv_indev_data_t input;
static uint32_t framebuffer[800 * 480];
static const char *preview_directory;
static void check_tree(lv_obj_t *parent);
static void read_pointer(lv_indev_t *indev, lv_indev_data_t *data) { (void)indev; *data = input; }
static void flush(lv_display_t *display, const lv_area_t *area, uint8_t *pixels) {
    for(int y = area->y1; y <= area->y2; ++y) {
        memcpy(&framebuffer[y * 800 + area->x1], pixels, (size_t)lv_area_get_width(area) * 4);
        pixels += lv_area_get_width(area) * 4;
    }
    lv_display_flush_ready(display);
}
static void preview(const char *name) {
    if(!preview_directory) return;
    lv_tick_inc(300); lv_timer_handler();
    lv_obj_invalidate(lv_screen_active()); lv_refr_now(NULL);
    char path[1024]; snprintf(path, sizeof(path), "%s/board-%s.ppm", preview_directory, name);
    FILE *file = fopen(path, "wb"); assert(file);
    fputs("P6\n800 480\n255\n", file);
    for(size_t i = 0; i < 800 * 480; ++i) {
        unsigned char rgb[] = {framebuffer[i] >> 16, framebuffer[i] >> 8, framebuffer[i]};
        assert(fwrite(rgb, 1, 3, file) == 3);
    }
    assert(fclose(file) == 0);
}
static void tap(int x, int y) {
    assert(x >= 0 && x < 800 && y >= 0 && y < 480);
    input.point.x = x; input.point.y = y;
    input.state = LV_INDEV_STATE_PRESSED; lv_indev_read(pointer); lv_tick_inc(20);
    input.state = LV_INDEV_STATE_RELEASED; lv_indev_read(pointer); lv_tick_inc(20);
    lv_obj_update_layout(lv_screen_active());
}
static lv_obj_t *keyboard_child(lv_obj_t *parent) {
    for(uint32_t i = 0; i < lv_obj_get_child_count(parent); ++i) {
        lv_obj_t *child = lv_obj_get_child(parent, i);
        if(lv_obj_check_type(child, &lv_keyboard_class)) return child;
    }
    assert(!"keyboard missing"); return NULL;
}
static bool inside(lv_obj_t *obj, const char *description) {
    lv_area_t area; lv_obj_get_coords(obj, &area);
    if(area.x1 < 0 || area.y1 < 0 || area.x2 >= 800 || area.y2 >= 480) {
        fprintf(stderr, "%s outside 800x480: (%d,%d)-(%d,%d)\n", description,
                (int)area.x1, (int)area.y1, (int)area.x2, (int)area.y2);
        return false;
    }
    return true;
}
static bool keyboard_geometry(lv_obj_t *keyboard, int y, int height) {
    if(!inside(keyboard, "keyboard")) return false;
    lv_area_t area; lv_obj_get_coords(keyboard, &area);
    assert(area.x1 == 12 && area.y1 == y && lv_area_get_width(&area) == 776 &&
           lv_area_get_height(&area) == height);
    lv_buttonmatrix_t *matrix = (lv_buttonmatrix_t *)keyboard;
    assert(matrix->btn_cnt > 0);
    /* Include every actual key hit rectangle, especially the bottom row. */
    for(uint32_t i = 0; i < matrix->btn_cnt; ++i) {
        lv_area_t key = matrix->button_areas[i];
        assert(key.x1 >= 0 && key.y1 >= 0 && key.x2 < 776 && key.y2 < height);
        assert(area.x1 + key.x1 >= 0 && area.y1 + key.y1 >= 0);
        assert(area.x1 + key.x2 < 800 && area.y1 + key.y2 < 480);
    }
    return true;
}
static void tap_key(lv_obj_t *keyboard, const char *text) {
    lv_buttonmatrix_t *matrix = (lv_buttonmatrix_t *)keyboard;
    for(uint32_t i = 0; i < matrix->btn_cnt; ++i) {
        if(strcmp(lv_buttonmatrix_get_button_text(keyboard, i), text) != 0) continue;
        lv_area_t area; lv_obj_get_coords(keyboard, &area);
        const lv_area_t *key = &matrix->button_areas[i];
        tap(area.x1 + (key->x1 + key->x2) / 2, area.y1 + (key->y1 + key->y2) / 2);
        return;
    }
    assert(!"key missing");
}
static void clean_screen(void) {
    group_close_command();
    lv_obj_clean(lv_screen_active());
    group_command_pending = group_voice_submitted = group_voice_active = false;
    group_command_detail_text[0] = 0;
    group_dropdown = lv_dropdown_create(lv_screen_active());
    lv_obj_add_flag(group_dropdown, LV_OBJ_FLAG_HIDDEN);
    group_detail_label = lv_label_create(lv_screen_active());
    group_name_label = lv_label_create(lv_screen_active());
    group_ptt_button = lv_button_create(lv_screen_active());
    group_status_label = lv_label_create(lv_screen_active());
    group_action_label = lv_label_create(lv_screen_active());
    group_switch_button = lv_button_create(lv_screen_active());
    group_switch_label = lv_label_create(group_switch_button);
    group_ptt_label = lv_label_create(group_ptt_button);
    choices.known = true; choices.can_select = true; choices.switching = false;
    group_choices_valid = true; group_stop_action = true; group_transport_ready = true;
    group_joining = false; group_modal = GROUP_MODAL_NONE; group_switch_pending = false;
    strlcpy(choices.current_id, "a", sizeof(choices.current_id));
    strlcpy(choices.items[0].name, "后勤组", sizeof(choices.items[0].name));
    /* This fixture replaces the worker directory publication. Give the real
     * dropdown the same authorized options without inventing a live backend. */
    lv_dropdown_set_options(group_dropdown, "后勤组\n验收测试群");
    lv_dropdown_set_text_static(group_dropdown, NULL); lv_dropdown_set_selected(group_dropdown, 0);
    strlcpy(choices.items[1].name, "验收测试群", sizeof(choices.items[1].name));
}
static void open_join(void) {
    lv_obj_t *opener = lv_button_create(lv_screen_active());
    lv_obj_add_event_cb(opener, group_join_open_event_cb, LV_EVENT_CLICKED, NULL);
    lv_obj_send_event(opener, LV_EVENT_CLICKED, NULL);
    lv_obj_update_layout(lv_screen_active());
    assert(group_modal == GROUP_MODAL_JOIN && group_command_overlay);
}
static bool test_join(void) {
    clean_screen(); open_join();
    lv_obj_t *keyboard = keyboard_child(group_command_overlay);
    if(!keyboard_geometry(keyboard, 178, 290)) return false;
    assert(inside(group_join_textarea, "join input"));
    assert(inside(group_command_submit, "join submit"));
    assert(inside(group_command_cancel, "join cancel"));
    check_tree(group_command_overlay);
    preview("join");
    /* Use real pointer hit testing and LVGL keyboard processing, not a synthetic
     * READY event: type eight letters, then tap the actual bottom-row OK key. */
    for(const char *letter = "ABCDEFGH"; *letter; ++letter) {
        const char key[] = { *letter, 0 }; tap_key(keyboard, key);
    }
    assert(strcmp(lv_textarea_get_text(group_join_textarea), "ABCDEFGH") == 0);
    tap_key(keyboard, LV_SYMBOL_OK);
    assert(join_calls == 1 && strcmp(submitted_code, "ABCDEFGH") == 0);
    assert(group_modal == GROUP_MODAL_NONE && !group_join_textarea && !group_command_overlay);
    group_command_pending = false;
    open_join(); keyboard = keyboard_child(group_command_overlay);
    assert(strcmp(lv_textarea_get_text(group_join_textarea), "") == 0);
    tap_key(keyboard, "A"); tap_key(keyboard, LV_SYMBOL_CLOSE);
    assert(group_modal == GROUP_MODAL_NONE && !group_join_textarea && join_calls == 1);
    puts("Join keyboard: (12,178)-(787,467), all keys in bounds; pointer input/OK/cancel passed.");
    return true;
}
static bool test_wifi(void) {
    clean_screen();
    lv_obj_t *textarea = lv_textarea_create(lv_screen_active());
    lv_obj_align(textarea, LV_ALIGN_TOP_LEFT, 60, 126);
    lv_obj_set_size(textarea, 680, 48); lv_textarea_set_one_line(textarea, true);
    lv_obj_t *keyboard = create_rti_keyboard(lv_screen_active(), textarea);
    lv_obj_update_layout(lv_screen_active());
    if(!keyboard_geometry(keyboard, 190, 286)) return false;
    assert(inside(textarea, "Wi-Fi input"));
    tap_key(keyboard, "!");
    assert(strcmp(lv_textarea_get_text(textarea), "!") == 0);
    puts("Wi-Fi keyboard: (12,190)-(787,475), all keys in bounds; bottom-row ! pointer input passed.");
    return true;
}
static bool test_voice(void) {
    clean_screen();
    lv_obj_t *opener = lv_button_create(lv_screen_active());
    lv_obj_add_event_cb(opener, group_voice_open_event_cb, LV_EVENT_CLICKED, NULL);
    lv_obj_send_event(opener, LV_EVENT_CLICKED, NULL);
    lv_obj_update_layout(lv_screen_active());
    assert(group_modal == GROUP_MODAL_VOICE);
    assert(inside(group_command_title, "voice title"));
    assert(inside(group_command_detail, "voice detail"));
    assert(inside(group_command_current, "voice current group"));
    assert(inside(group_command_submit, "voice start"));
    assert(inside(group_command_cancel, "voice cancel"));
    check_tree(group_command_overlay);
    assert(strcmp(lv_label_get_text(group_command_current), "当前群：后勤组") == 0);
    preview("voice");
    lv_area_t area; lv_obj_get_coords(group_command_submit, &area);
    tap((area.x1 + area.x2) / 2, (area.y1 + area.y2) / 2);
    assert(voice_calls == 1 && group_command_pending);
    assert(strcmp(lv_label_get_text(group_command_title), "正在准备") == 0);
    /* A stale ready transport must not claim readiness while command work is
     * pending or recovery is still active. */
    group_command_pending = false; group_voice_active = true; group_voice_can_cancel = true;
    group_render_command();
    assert(strcmp(lv_label_get_text(group_command_title), "语音切群") == 0);
    assert(strcmp(lv_label_get_text(group_command_cancel_label), "取消语音") == 0);
    group_voice_can_cancel = false; group_render_command();
    assert(strcmp(lv_label_get_text(group_command_cancel_label), "请等待恢复") == 0);
    assert(lv_obj_has_state(group_command_cancel, LV_STATE_DISABLED));
    /* Exercise the actual authoritative current-label publication chain while
     * the modal covers the main page. It must update without reopening. */
    strlcpy(choices.current_id, "b", sizeof(choices.current_id));
    group_render_current();
    assert(strcmp(lv_label_get_text(group_name_label), "当前群：验收测试群") == 0);
    assert(strcmp(lv_label_get_text(group_command_current), "当前群：验收测试群") == 0);
    group_voice_active = false; group_transport_ready = false;
    strlcpy(group_command_detail_text, "没有识别到明确的已加入群，已恢复当前群", sizeof(group_command_detail_text));
    group_render_command();
    assert(strcmp(lv_label_get_text(group_command_title), "语音切群已结束") == 0);
    assert(strcmp(lv_label_get_text(group_command_detail), group_command_detail_text) == 0);
    assert(strcmp(lv_label_get_text(group_command_cancel_label), "返回对讲") == 0);
    /* Ready state is published after command completion; its actual renderer
     * must refresh the modal too, preserving the previous failure/cancel reason. */
    assert(board_display_set_group_state("ignored-untrusted-name", "recovered", true, false) == ESP_OK);
    assert(strcmp(lv_label_get_text(group_command_title), "当前群音频已就绪") == 0);
    assert(strcmp(lv_label_get_text(group_command_detail), group_command_detail_text) == 0);
    for(size_t i = 0; i < 42; ++i) memcpy(choices.items[1].name + i * 3, "验", 3);
    choices.items[1].name[126] = 0;
    group_render_current(); lv_obj_update_layout(lv_screen_active());
    char expected[160]; snprintf(expected, sizeof(expected), "当前群：%s", choices.items[1].name);
    assert(strcmp(lv_label_get_text(group_command_current), expected) == 0);
    assert(inside(group_command_current, "long UTF-8 current group"));
    /* Unknown state must not retain a previous destination or ready claim. */
    choices.known = false; group_render_current();
    assert(strcmp(lv_label_get_text(group_command_current), "当前群尚未确认") == 0);
    assert(strcmp(lv_label_get_text(group_command_title), "语音切群已结束") == 0);
    lv_obj_get_coords(group_command_cancel, &area);
    tap((area.x1 + area.x2) / 2, (area.y1 + area.y2) / 2);
    assert(group_modal == GROUP_MODAL_NONE && !group_command_overlay && !group_command_current);
    puts("Voice modal: authoritative group refresh/UTF-8, pending/recovery gates, failure detail, and pointer return passed.");
    return true;
}
static unsigned volume_calls, volume_persists;
static uint8_t last_volume, last_persisted_volume;
static void volume_action(uint8_t value, bool persist, void *context) {
    assert(context == &volume_calls);
    ++volume_calls; last_volume = value;
    if(persist) { ++volume_persists; last_persisted_volume = value; }
}
static lv_obj_t *group_slider(void) {
    for(uint32_t i = 0; i < lv_obj_get_child_count(lv_screen_active()); ++i) {
        lv_obj_t *child = lv_obj_get_child(lv_screen_active(), i);
        if(lv_obj_check_type(child, &lv_slider_class)) return child;
    }
    assert(!"group volume slider missing"); return NULL;
}
static void pointer_state(int x, int y, lv_indev_state_t state) {
    input.point.x = x; input.point.y = y; input.state = state;
    lv_indev_read(pointer); lv_tick_inc(20); lv_obj_update_layout(lv_screen_active());
}
static bool test_volume(void) {
    const uint8_t levels[] = {0, 30, 55, 100};
    for(size_t i = 0; i < sizeof(levels) / sizeof(levels[0]); ++i) {
        volume_calls = volume_persists = 0;
        assert(board_display_show_group(NULL, NULL, NULL, volume_action, levels[i], &volume_calls) == ESP_OK);
        lv_obj_update_layout(lv_screen_active());
        lv_obj_t *slider = group_slider();
        assert(inside(slider, "group volume slider"));
        assert(lv_slider_get_value(slider) == levels[i]);
        assert(volume_calls == 1 && last_volume == levels[i] && volume_persists == 0);
        char expected[48];
        snprintf(expected, sizeof(expected), levels[i] ? "收听音量 %u%%" : "收听已静音 %u%%", (unsigned)levels[i]);
        assert(strcmp(lv_label_get_text(group_volume_label), expected) == 0);
    }
    volume_calls = volume_persists = 0;
    assert(board_display_show_group(NULL, NULL, NULL, volume_action, 30, &volume_calls) == ESP_OK);
    lv_obj_update_layout(lv_screen_active());
    lv_obj_t *slider = group_slider();
    lv_area_t area; lv_obj_get_coords(slider, &area);
    const int y = (area.y1 + area.y2) / 2;
    /* Real LVGL pointer press/drag emits VALUE_CHANGED. No direct production
     * callback invocation or hand-built RELEASED event stands in for a gesture. */
    pointer_state(area.x1 + lv_area_get_width(&area) * 30 / 100, y, LV_INDEV_STATE_PRESSED);
    pointer_state(area.x1 + lv_area_get_width(&area) * 50 / 100, y, LV_INDEV_STATE_PRESSED);
    pointer_state(area.x1 + lv_area_get_width(&area) * 70 / 100, y, LV_INDEV_STATE_PRESSED);
    assert(volume_calls >= 3 && volume_persists == 0);
    const uint8_t final_value = (uint8_t)lv_slider_get_value(slider);
    assert(final_value >= 65 && final_value <= 75 && last_volume == final_value);
    pointer_state(input.point.x, y, LV_INDEV_STATE_RELEASED);
    assert(volume_persists == 1 && last_persisted_volume == final_value && last_volume == final_value);
    char expected[48]; snprintf(expected, sizeof(expected), "收听音量 %u%%", (unsigned)final_value);
    assert(strcmp(lv_label_get_text(group_volume_label), expected) == 0);
    puts("Group volume: loaded 0/30/55/100 retained; real slider drag applies live without persistence, release saves final value once.");
    return true;
}
static bool disjoint(lv_obj_t *a, lv_obj_t *b) {
    lv_area_t x, y; lv_obj_get_coords(a, &x); lv_obj_get_coords(b, &y);
    return x.x2 < y.x1 || y.x2 < x.x1 || x.y2 < y.y1 || y.y2 < x.y1;
}
static void check_tree(lv_obj_t *parent) {
    for(uint32_t i = 0; i < lv_obj_get_child_count(parent); ++i) {
        lv_obj_t *child = lv_obj_get_child(parent, i);
        if(lv_obj_has_flag(child, LV_OBJ_FLAG_HIDDEN)) continue;
        assert(inside(child, "page/modal child"));
        if(lv_obj_check_type(child, &lv_label_class)) {
            const lv_font_t *font = lv_obj_get_style_text_font(child, 0);
            const unsigned char *p = (const unsigned char *)lv_label_get_text(child);
            while(*p) {
                uint32_t point = *p++;
                if(point >= 0xc0) {
                    unsigned tail = point < 0xe0 ? 1 : point < 0xf0 ? 2 : 3;
                    point &= (1u << (6 - tail)) - 1;
                    while(tail--) point = (point << 6) | (*p++ & 0x3f);
                }
                if(point == '\n') continue;
                lv_font_glyph_dsc_t glyph = {0};
                if(!lv_font_get_glyph_dsc(font, &glyph, point, 0) || glyph.is_placeholder) {
                    fprintf(stderr, "Missing visible glyph U+%04X in %.80s\n", (unsigned)point, lv_label_get_text(child));
                    assert(!"missing UI glyph");
                }
            }
            for(uint32_t j = i + 1; j < lv_obj_get_child_count(parent); ++j) {
                lv_obj_t *other = lv_obj_get_child(parent, j);
                if(lv_obj_check_type(other, &lv_label_class) && !lv_obj_has_flag(other, LV_OBJ_FLAG_HIDDEN)) {
                    if(!disjoint(child, other)) fprintf(stderr, "Overlapping labels: %.80s / %.80s\n",
                        lv_label_get_text(child), lv_label_get_text(other));
                    assert(disjoint(child, other));
                }
            }
        }
        check_tree(child);
    }
}
static void check_ui_glyphs(void) {
    const unsigned char *p = (const unsigned char *)font_coverage;
    unsigned count = 0;
    while(*p) {
        uint32_t point = *p++;
        if(point >= 0xc0) {
            unsigned tail = point < 0xe0 ? 1 : point < 0xf0 ? 2 : 3;
            point &= (1u << (6 - tail)) - 1;
            while(tail--) point = (point << 6) | (*p++ & 0x3f);
        }
        lv_font_glyph_dsc_t glyph = {0};
        assert(lv_font_get_glyph_dsc(&shenglu_ui_24, &glyph, point, 0));
        assert(!glyph.is_placeholder && glyph.resolved_font == &shenglu_ui_24);
        ++count;
    }
    printf("UI 24px subset: %u non-ASCII source glyphs verified; no brand-font fallback.\n", count);
}
static void check_dynamic_glyphs(void) {
    const unsigned char *p = (const unsigned char *)dynamic_coverage;
    unsigned count = 0;
    for(unsigned ascii = 32; ascii <= 126; ++ascii) {
        lv_font_glyph_dsc_t glyph = {0};
        assert(lv_font_get_glyph_dsc(&shenglu_group_20_gb2312, &glyph, ascii, 0) && !glyph.is_placeholder);
    }
    while(*p) {
        uint32_t point = *p++;
        if(point >= 0xc0) {
            unsigned tail = point < 0xe0 ? 1 : point < 0xf0 ? 2 : 3;
            point &= (1u << (6 - tail)) - 1;
            while(tail--) point = (point << 6) | (*p++ & 0x3f);
        }
        lv_font_glyph_dsc_t old = {0}, next = {0};
        const bool old_available = lv_font_get_glyph_dsc(TRANSCRIPT_FONT, &old, point, 0) && !old.is_placeholder;
        const bool next_available = lv_font_get_glyph_dsc(&shenglu_group_20_gb2312, &next, point, 0) && !next.is_placeholder;
        assert(old_available == next_available);
        if(next_available) assert(next.resolved_font == &shenglu_group_20_gb2312);
        ++count;
    }
    lv_font_glyph_dsc_t emoji = {0};
    assert(!lv_font_get_glyph_dsc(&shenglu_group_20_gb2312, &emoji, 0x1f600, 0) || emoji.is_placeholder);
    printf("Dynamic group 20px/2bpp: %u original symbols + 95 ASCII checked against 16px coverage; no emoji expansion.\n", count);
}
static unsigned page_press, page_release;
static void page_ptt(bool pressed, void *context) {
    (void)context; if(pressed) ++page_press; else ++page_release;
}
static bool test_group_page(void) {
    assert(board_display_show_group(NULL, page_ptt, NULL, volume_action, 38, &volume_calls) == ESP_OK);
    choices.known = choices.can_select = true; choices.switching = false;
    group_choices_valid = group_candidate_valid = true;
    strlcpy(choices.current_id, "a", sizeof(choices.current_id));
    strlcpy(choices.items[0].name, "后勤组", sizeof(choices.items[0].name));
    lv_dropdown_set_options(group_dropdown, "后勤组\n验收测试群");
    lv_dropdown_set_text_static(group_dropdown, NULL); lv_dropdown_set_selected(group_dropdown, 0);
    group_stop_action = true;
    assert(board_display_set_group_state(NULL, "正在连接群语音，请稍候", false, false) == ESP_OK);
    lv_obj_update_layout(lv_screen_active()); preview("connecting");
    assert(lv_obj_has_state(group_ptt_button, LV_STATE_DISABLED));
    assert(board_display_set_group_state(NULL, "按住说话，与当前群组沟通", true, false) == ESP_OK);
    lv_obj_update_layout(lv_screen_active());
    check_tree(lv_screen_active()); check_ui_glyphs(); check_dynamic_glyphs();
    assert(lv_obj_get_style_text_font(group_name_label, 0) == &shenglu_group_20_gb2312);
    assert(lv_obj_get_style_text_font(group_ptt_label, 0) == &shenglu_ui_24);
    assert(lv_obj_get_style_text_font(group_status_label, 0) == TRANSCRIPT_FONT);
    assert(disjoint(group_name_label, group_status_label) && disjoint(group_name_label, group_detail_label));
    lv_obj_t *buttons[] = {lv_obj_get_parent(group_action_label), group_ptt_button,
                          group_voice_button, group_join_button, group_dropdown, group_switch_button,
                          group_recommendation_button};
    for(size_t i = 0; i < sizeof(buttons) / sizeof(buttons[0]); ++i) {
        assert(inside(buttons[i], "page control"));
        assert(lv_obj_get_width(buttons[i]) >= 44 && lv_obj_get_height(buttons[i]) >= 44);
        for(size_t j = i + 1; j < sizeof(buttons) / sizeof(buttons[0]); ++j) assert(disjoint(buttons[i], buttons[j]));
    }
    lv_area_t ptt; lv_obj_get_coords(group_ptt_button, &ptt);
    assert(lv_area_get_width(&ptt) >= 500 && lv_area_get_height(&ptt) >= 150);
    page_press = page_release = 0;
    pointer_state(ptt.x1 + 4, ptt.y1 + 4, LV_INDEV_STATE_PRESSED);
    assert(page_press == 1 && group_pressed);
    pointer_state(ptt.x2 - 4, ptt.y2 - 4, LV_INDEV_STATE_RELEASED);
    assert(page_release == 1 && !group_pressed);
    preview("ready");
    assert(board_display_set_group_state(NULL, "松手后结束本次发言", true, true) == ESP_OK);
    lv_obj_update_layout(lv_screen_active()); preview("speaking");
    assert(strcmp(lv_label_get_text(group_status_label), "正在发言") == 0);
    /* Long UTF-8 names stay within the fixed label, including the old 42-char
     * boundary fixture; no small four-character brand font renders them. */
    for(size_t i = 0; i < 32; ++i) memcpy(choices.items[0].name + i * 3, "验", 3);
    choices.items[0].name[96] = 0;
    char long_options[300]; snprintf(long_options, sizeof(long_options), "%s\n验收测试群", choices.items[0].name);
    lv_dropdown_set_options(group_dropdown, long_options); group_render_current();
    lv_obj_update_layout(lv_screen_active()); check_tree(lv_screen_active());
    assert(lv_obj_get_height(group_name_label) == 32 && lv_label_get_long_mode(group_name_label) == LV_LABEL_LONG_MODE_DOTS);
    preview("long-name");
    for(size_t i = 0; i < 42; ++i) memcpy(choices.items[0].name + i * 3, "验", 3);
    choices.items[0].name[126] = 0; group_render_current();
    lv_obj_update_layout(lv_screen_active()); check_tree(lv_screen_active());
    choices.items[0].name[96] = 0; group_render_current();
    lv_dropdown_set_options(group_dropdown, long_options);
    lv_obj_remove_state(group_dropdown, LV_STATE_DISABLED); lv_dropdown_open(group_dropdown);
    group_render_controls(); lv_obj_update_layout(lv_screen_active());
    assert(inside(lv_dropdown_get_list(group_dropdown), "upward group list"));
    assert(lv_obj_has_state(group_ptt_button, LV_STATE_DISABLED));
    preview("group-list"); lv_dropdown_close(group_dropdown);
    group_voice_active = true; group_render_controls();
    assert(lv_obj_has_state(group_ptt_button, LV_STATE_DISABLED));
    assert(strcmp(lv_label_get_text(group_status_label), "语音切群进行中") == 0);
    group_voice_active = false; group_render_controls();
    lv_obj_t *slider = group_slider(); lv_area_t track; lv_obj_get_coords(slider, &track);
    const int x = (track.x1 + track.x2) / 2;
    unsigned hit_rows = 0;
    for(int y = track.y1 - 17; y <= track.y2 + 17; ++y) {
        lv_point_t point = {x, y};
        assert(y >= 0 && y < 480 && y > 418);
        assert(lv_obj_hit_test(slider, &point)); ++hit_rows;
    }
    assert(hit_rows >= 44);
    const int touch_rows[] = {track.y1 - 17, track.y2 + 17};
    for(size_t i = 0; i < 2; ++i) {
        volume_persists = 0;
        pointer_state(x, touch_rows[i], LV_INDEV_STATE_PRESSED);
        pointer_state(x, touch_rows[i], LV_INDEV_STATE_RELEASED);
        assert(volume_persists == 1 && last_persisted_volume == (uint8_t)lv_slider_get_value(slider));
    }
    puts("Group page: bounded controls/long Chinese, non-overlap, real PTT release, upward list gates and 44px slider pointer targets passed.");
    return true;
}

static unsigned recommendation_calls;
static group_recommendation_action_t recommendation_action;
static unsigned recommendation_index;
static uint32_t recommendation_revision;
static esp_err_t recommendation_action_fixture(group_recommendation_action_t action,
                                               unsigned index, uint32_t revision, void *context) {
    assert(context == &recommendation_calls);
    ++recommendation_calls; recommendation_action = action;
    recommendation_index = index; recommendation_revision = revision;
    return ESP_OK;
}
static void tap_center(lv_obj_t *object) {
    lv_obj_update_layout(lv_screen_active());
    lv_area_t area; lv_obj_get_coords(object, &area);
    tap((area.x1 + area.x2) / 2, (area.y1 + area.y2) / 2);
}
static void check_recommendation_cards(void) {
    lv_obj_update_layout(lv_screen_active());
    assert(inside(group_recommendation_list, "recommendation viewport"));
    assert(inside(group_recommendation_footer, "recommendation footer"));
    assert(inside(group_recommendation_submit, "recommendation confirm"));
    assert(inside(group_recommendation_cancel, "recommendation cancel"));
    assert(disjoint(group_recommendation_list, group_recommendation_footer));
    assert(disjoint(group_recommendation_footer, group_recommendation_submit));
    assert(disjoint(group_recommendation_submit, group_recommendation_cancel));
    lv_obj_t *fixed[] = {group_recommendation_title,group_recommendation_detail,
        group_recommendation_footer,group_recommendation_submit_label,group_recommendation_cancel_label};
    for(unsigned i=0;i<sizeof(fixed)/sizeof(fixed[0]);++i) {
        const unsigned char *p=(const unsigned char *)lv_label_get_text(fixed[i]);
        while(*p) {
            uint32_t point=*p++;
            if(point>=0xc0) {
                unsigned tail=point<0xe0?1:point<0xf0?2:3;
                point&=(1u<<(6-tail))-1;
                while(tail--)point=(point<<6)|(*p++&0x3f);
            }
            if(point=='\n')continue;
            lv_font_glyph_dsc_t glyph={0};
            assert(lv_font_get_glyph_dsc(&shenglu_group_20_gb2312,&glyph,point,0)&&!glyph.is_placeholder);
        }
    }
    for(unsigned i = 0; i < group_recommendation_view.count; ++i) {
        lv_obj_t *card = group_recommendation_cards[i];
        assert(card && lv_obj_get_width(card) == 704);
        for(unsigned j = i + 1; j < group_recommendation_view.count; ++j)
            assert(disjoint(card, group_recommendation_cards[j]));
        /* Off-screen cards intentionally live inside a clipped scroll view.
         * Check each actual label's full Chinese coverage and vertical extent. */
        lv_area_t outer; lv_obj_get_coords(card, &outer);
        for(uint32_t n = 0; n < lv_obj_get_child_count(card); ++n) {
            lv_obj_t *label = lv_obj_get_child(card, n);
            lv_area_t area; lv_obj_get_coords(label, &area);
            assert(area.x1 >= outer.x1 && area.x2 <= outer.x2 && area.y1 >= outer.y1 && area.y2 <= outer.y2);
            const unsigned char *p = (const unsigned char *)lv_label_get_text(label);
            while(*p) {
                uint32_t point = *p++;
                if(point >= 0xc0) {
                    unsigned tail = point < 0xe0 ? 1 : point < 0xf0 ? 2 : 3;
                    point &= (1u << (6 - tail)) - 1;
                    while(tail--) point = (point << 6) | (*p++ & 0x3f);
                }
                lv_font_glyph_dsc_t glyph = {0};
                assert(lv_font_get_glyph_dsc(&shenglu_group_20_gb2312, &glyph, point, 0) && !glyph.is_placeholder);
            }
            for(uint32_t m = n + 1; m < lv_obj_get_child_count(card); ++m)
                assert(disjoint(label, lv_obj_get_child(card, m)));
        }
    }
}
static bool test_recommendation(void) {
    assert(board_display_show_group(NULL, page_ptt, NULL, volume_action, 38, &volume_calls) == ESP_OK);
    choices.known = choices.can_select = true; choices.switching = false;
    group_choices_valid = group_candidate_valid = true; group_stop_action = true;
    strlcpy(choices.current_id, "a", sizeof(choices.current_id));
    strlcpy(choices.items[0].name, "后勤组", sizeof(choices.items[0].name));
    assert(board_display_set_group_state(NULL, "群语音已就绪", true, false) == ESP_OK);
    assert(board_display_set_group_recommendation_action(recommendation_action_fixture, &recommendation_calls) == ESP_OK);
    group_recommendation_view_t view = {.phase=GROUP_RECOMMENDATION_IDLE,.revision=1,.can_start=true};
    assert(board_display_set_group_recommendation(&view, NULL) == ESP_OK);
    lv_obj_update_layout(lv_screen_active());
    assert(!lv_obj_has_state(group_recommendation_button, LV_STATE_DISABLED));
    recommendation_calls = 0;
    tap_center(group_recommendation_button);
    assert(group_modal == GROUP_MODAL_RECOMMENDATION && recommendation_calls == 0);
    assert(lv_obj_has_state(group_ptt_button, LV_STATE_DISABLED));
    check_tree(group_command_overlay); preview("recommendation-prepare");
    const unsigned allocated = psram_allocations;
    tap_center(group_recommendation_submit);
    assert(recommendation_calls == 1 && recommendation_action == GROUP_RECOMMENDATION_START && recommendation_revision == 1);
    assert(psram_allocations == allocated && group_recommendation_pending);
    tap_center(group_recommendation_submit); assert(recommendation_calls == 1);
    assert(board_display_set_group_recommendation(&view, NULL) == ESP_OK && group_recommendation_pending);
    view.phase=GROUP_RECOMMENDATION_PREPARING;view.revision=2;view.can_start=false;view.can_cancel=true;
    const unsigned releases = page_release;
    assert(board_display_set_group_recommendation(&view, NULL) == ESP_OK && !group_recommendation_pending);
    assert(page_release == releases);
    view.phase=GROUP_RECOMMENDATION_LISTENING;view.revision=3;
    strlcpy(view.detail,"现在请说出你需要的协助，说完后等待建议",sizeof(view.detail));
    assert(board_display_set_group_recommendation(&view, NULL) == ESP_OK);
    check_tree(group_command_overlay);preview("recommendation-listening");
    view.phase=GROUP_RECOMMENDATION_REQUESTING;view.revision=4;
    strlcpy(view.detail,"需求采集已结束，正在等待已加入群的建议",sizeof(view.detail));
    assert(board_display_set_group_recommendation(&view, NULL) == ESP_OK);
    check_tree(group_command_overlay);preview("recommendation-waiting");
    group_recommendation_item_t items[3]={0};
    for(unsigned i=0;i<3;++i) {
        for(unsigned n=0;n<32;++n)memcpy(items[i].name+n*3,i==0?"设":i==1?"后":"现",3);
        for(unsigned n=0;n<256;++n)memcpy(items[i].purpose+n*3,"验",3);
        for(unsigned n=0;n<160;++n)memcpy(items[i].reason+n*3,"协",3);
    }
    view.phase=GROUP_RECOMMENDATION_CHOOSING;view.revision=5;view.count=3;
    view.can_confirm=true;view.expires_remaining_ms=55000;
    strlcpy(view.detail,"建议只供选择，不表示有人在线或已经接听",sizeof(view.detail));
    assert(board_display_set_group_recommendation(&view, items) == ESP_OK);
    assert(group_recommendation_items != items && psram_allocations == allocated+1);
    items[0].name[0]='X';assert(group_recommendation_items[0].name[0]!='X');items[0].name[0]=(char)0xe8;
    lv_obj_update_layout(lv_screen_active());check_recommendation_cards();
    assert(lv_obj_get_scroll_bottom(group_recommendation_list)>0);
    assert(lv_obj_has_state(group_recommendation_submit,LV_STATE_DISABLED));
    preview("recommendation-choices");
    /* A real pointer scroll must not select a card or confirm anything. */
    pointer_state(700,330,LV_INDEV_STATE_PRESSED);
    for(int y=300;y>=160;y-=20)pointer_state(700,y,LV_INDEV_STATE_PRESSED);
    pointer_state(700,160,LV_INDEV_STATE_RELEASED);
    assert(lv_obj_get_scroll_y(group_recommendation_list)>0);
    assert(group_recommendation_selected==-1&&recommendation_calls==1);
    preview("recommendation-scrolled");
    lv_obj_scroll_to_view(group_recommendation_cards[2],LV_ANIM_OFF);
    lv_obj_update_layout(lv_screen_active());
    lv_area_t last,viewport;lv_obj_get_coords(group_recommendation_cards[2],&last);lv_obj_get_coords(group_recommendation_list,&viewport);
    int top=last.y1>viewport.y1+8?last.y1:viewport.y1+8;
    int bottom=last.y2<viewport.y2-8?last.y2:viewport.y2-8;
    tap(500,(top+bottom)/2);
    assert(group_recommendation_selected==2&&recommendation_calls==1);
    assert(!lv_obj_has_state(group_recommendation_submit,LV_STATE_DISABLED));
    const uint32_t deadline=group_recommendation_deadline;
    const int32_t scroll=lv_obj_get_scroll_y(group_recommendation_list);
    view.expires_remaining_ms=60000;
    assert(board_display_set_group_recommendation(&view,items)==ESP_OK);
    assert(group_recommendation_deadline==deadline&&group_recommendation_selected==2);
    assert(lv_obj_get_scroll_y(group_recommendation_list)==scroll&&recommendation_calls==1);
    preview("recommendation-selected");
    check_recommendation_cards();
    tap_center(group_recommendation_submit);
    assert(recommendation_calls==2&&recommendation_action==GROUP_RECOMMENDATION_CONFIRM&&recommendation_index==2&&recommendation_revision==5);
    tap_center(group_recommendation_submit);assert(recommendation_calls==2);
    assert(board_display_set_group_recommendation(&view,items)==ESP_OK&&group_recommendation_pending);
    view.phase=GROUP_RECOMMENDATION_CONFIRMING;view.revision=6;view.count=0;view.can_cancel=false;view.can_confirm=false;view.expires_remaining_ms=0;
    strlcpy(view.detail,"正在核对操作终态，请勿重复确认",sizeof(view.detail));
    assert(board_display_set_group_recommendation(&view,NULL)==ESP_OK);
    tap_center(group_recommendation_cancel);assert(recommendation_calls==2);
    preview("recommendation-confirming");
    view.phase=GROUP_RECOMMENDATION_RECOVERING;view.revision=7;
    strlcpy(view.detail,"已取得操作终态，正在按当前群恢复音频",sizeof(view.detail));
    assert(board_display_set_group_recommendation(&view,NULL)==ESP_OK);
    assert(!strstr(lv_label_get_text(group_recommendation_title),"已接通"));
    preview("recommendation-recovering");
    view.phase=GROUP_RECOMMENDATION_IDLE;view.revision=8;view.can_start=true;
    strlcpy(view.detail,"当前群音频已就绪",sizeof(view.detail));
    assert(board_display_set_group_recommendation(&view,NULL)==ESP_OK);
    tap_center(group_recommendation_cancel);assert(group_modal==GROUP_MODAL_NONE&&!group_recommendation_timer);
    tap_center(group_recommendation_button);tap_center(group_recommendation_submit);
    assert(recommendation_calls==3&&recommendation_action==GROUP_RECOMMENDATION_START);
    view.phase=GROUP_RECOMMENDATION_CHOOSING;view.revision=9;view.count=3;view.can_start=false;view.can_cancel=true;view.can_confirm=true;view.expires_remaining_ms=1000;
    assert(board_display_set_group_recommendation(&view,items)==ESP_OK);
    lv_tick_inc(1200);lv_timer_handler();group_render_recommendation();
    assert(group_recommendation_expired()&&lv_obj_has_flag(group_recommendation_submit,LV_OBJ_FLAG_HIDDEN));
    lv_obj_send_event(group_recommendation_cards[0],LV_EVENT_CLICKED,NULL);
    lv_obj_send_event(group_recommendation_submit,LV_EVENT_CLICKED,NULL);
    assert(recommendation_calls==3&&group_recommendation_selected==-1);
    preview("recommendation-expired");
    tap_center(group_recommendation_cancel);assert(recommendation_calls==4&&recommendation_action==GROUP_RECOMMENDATION_CANCEL);
    view.phase=GROUP_RECOMMENDATION_RECOVERING;view.revision=10;view.count=0;view.can_cancel=false;view.can_confirm=false;view.expires_remaining_ms=0;
    assert(board_display_set_group_recommendation(&view,NULL)==ESP_OK);
    view.phase=GROUP_RECOMMENDATION_FAILED;view.revision=11;view.can_start=true;
    strlcpy(view.detail,"本次没有取得有效建议，请返回后重试",sizeof(view.detail));
    assert(board_display_set_group_recommendation(&view,NULL)==ESP_OK);
    assert(!strstr(lv_label_get_text(group_recommendation_title),"已接通"));
    check_tree(group_command_overlay);preview("recommendation-failed");
    group_recommendation_view_t stale=view;stale.revision=10;stale.phase=GROUP_RECOMMENDATION_CHOOSING;stale.count=3;
    assert(board_display_set_group_recommendation(&stale,items)==ESP_OK&&group_recommendation_view.phase==GROUP_RECOMMENDATION_FAILED);
    view.count=4;assert(board_display_set_group_recommendation(&view,items)==ESP_ERR_INVALID_ARG);view.count=3;
    psram_fail=true;assert(board_display_set_group_recommendation(&view,items)==ESP_ERR_NO_MEM);psram_fail=false;
    /* Accepted cancellation is a UI intent too: a newer choosing frame from
     * the same worker must never restore selectable cards. */
    view.phase=GROUP_RECOMMENDATION_CHOOSING;view.revision=12;
    view.can_cancel=view.can_confirm=true;view.expires_remaining_ms=30000;
    assert(board_display_set_group_recommendation(&view,items)==ESP_OK);
    assert(group_recommendation_view.phase==GROUP_RECOMMENDATION_CLEANUP);
    assert(!group_recommendation_items&&!group_recommendation_view.can_confirm);
    assert(!group_recommendation_cards[0]);
    view.phase=GROUP_RECOMMENDATION_IDLE;view.revision=13;view.count=0;
    view.can_start=true;view.can_cancel=view.can_confirm=false;view.expires_remaining_ms=0;
    assert(board_display_set_group_recommendation(&view,NULL)==ESP_OK);
    tap_center(group_recommendation_cancel);
    assert(group_modal==GROUP_MODAL_NONE);
    tap_center(group_recommendation_button);tap_center(group_recommendation_submit);
    assert(recommendation_calls==5&&recommendation_action==GROUP_RECOMMENDATION_START);
    const char *names[]={"设备问题协助组","后勤保障组","现场协调组"};
    const char *purposes[]={"排查设备无声、网络连接和音频设置问题","协助处理场地、物资与日常保障需求","协调现场任务分工与跨组沟通"};
    const char *reason="模型建议联系该组，请核对群职责后确认。";
    memset(items,0,sizeof(items));
    for(unsigned i=0;i<3;++i) {
        strlcpy(items[i].name,names[i],sizeof(items[i].name));
        strlcpy(items[i].purpose,purposes[i],sizeof(items[i].purpose));
        strlcpy(items[i].reason,reason,sizeof(items[i].reason));
    }
    view.phase=GROUP_RECOMMENDATION_CHOOSING;view.revision=14;view.count=3;view.can_start=false;
    view.can_cancel=view.can_confirm=true;view.expires_remaining_ms=30000;
    strlcpy(view.detail,"仅根据本次主动需求，推荐你已加入的群",sizeof(view.detail));
    assert(board_display_set_group_recommendation(&view,items)==ESP_OK);
    lv_obj_update_layout(lv_screen_active());
    preview("recommendation-typical");
    lv_area_t first;lv_obj_get_coords(group_recommendation_cards[0],&first);
    tap(500,first.y1+30);assert(recommendation_calls==5&&group_recommendation_selected==0);
    check_recommendation_cards();preview("recommendation-typical-selected");
    assert(strstr(lv_label_get_text(group_recommendation_footer),names[0]));
    /* Missing intermediate frames may deliver a new result directly over an
     * old choosing view. Its revision starts its own expiry and clears choice. */
    const uint32_t old_deadline=group_recommendation_deadline;
    view.revision=15;view.expires_remaining_ms=50000;
    strlcpy(items[0].name,"新的设备协助组",sizeof(items[0].name));
    assert(board_display_set_group_recommendation(&view,items)==ESP_OK);
    assert((int32_t)(group_recommendation_deadline-old_deadline)>0&&group_recommendation_selected==-1);
    assert(recommendation_calls==5&&lv_obj_has_state(group_recommendation_submit,LV_STATE_DISABLED));
    view.phase=GROUP_RECOMMENDATION_FAILED;view.revision=16;view.count=0;view.can_start=true;view.can_cancel=view.can_confirm=false;
    assert(board_display_set_group_recommendation(&view,NULL)==ESP_OK);
    tap_center(group_recommendation_cancel);assert(group_modal==GROUP_MODAL_NONE);
    puts("Recommendation UI: explicit start/selection/confirmation, real pointer scrolling of three maximum text cards, expiry/revision guards, PSRAM ownership and reason-only recovery/failure passed.");
    return true;
}
static bool test_voice_proposals(void) {
    assert(board_display_show_group(NULL,page_ptt,NULL,volume_action,38,&volume_calls)==ESP_OK);
    choices.known=choices.can_select=true;choices.switching=false;
    group_choices_valid=group_candidate_valid=true;group_stop_action=true;
    strlcpy(choices.current_id,"a",sizeof(choices.current_id));
    assert(board_display_set_group_state(NULL,"群语音已就绪",true,false)==ESP_OK);
    assert(board_display_set_group_recommendation_action(recommendation_action_fixture,&recommendation_calls)==ESP_OK);
    group_recommendation_view_t view={.phase=GROUP_RECOMMENDATION_IDLE,.revision=30,.can_start=true};
    assert(board_display_set_group_recommendation(&view,NULL)==ESP_OK);
    assert(board_display_set_group_command_state(30,false,false,false,"")==ESP_OK);
    recommendation_calls=0;
    tap_center(group_voice_button);
    assert(group_modal==GROUP_MODAL_VOICE);
    check_tree(group_command_overlay);preview("voice-target-prepare");
    tap_center(group_command_submit);
    assert(recommendation_calls==1&&recommendation_action==GROUP_RECOMMENDATION_START_VOICE);
    assert(recommendation_revision==30&&group_voice_origin_revision==30);
    assert(board_display_set_group_command_state(31,false,true,true,"现在请说目标群名称")==ESP_OK);
    view=(group_recommendation_view_t){.phase=GROUP_RECOMMENDATION_LISTENING,.revision=31,.voice_mode=true,.can_cancel=true};
    assert(board_display_set_group_recommendation(&view,NULL)==ESP_OK);
    group_recommendation_item_t item={0};
    strlcpy(item.name,"新版验收群",sizeof(item.name));
    strlcpy(item.purpose,"完成对讲与语音切群验收",sizeof(item.purpose));
    strlcpy(item.reason,"请核对识别出的目标群，确认后才会切换。",sizeof(item.reason));
    view.phase=GROUP_RECOMMENDATION_CHOOSING;view.revision=33;view.count=1;
    view.can_confirm=true;view.expires_remaining_ms=50000;
    strlcpy(view.detail,"请选择建议并明确确认进入，未确认不会切群",sizeof(view.detail));
    const unsigned releases=page_release,force_releases=release_calls;
    assert(board_display_set_group_recommendation(&view,&item)==ESP_OK);
    assert(group_modal==GROUP_MODAL_RECOMMENDATION&&group_recommendation_voice);
    assert(group_recommendation_origin_revision==30&&group_voice_origin_revision==0);
    assert(page_release==releases&&release_calls==force_releases&&recommendation_calls==1);
    assert(strstr(lv_label_get_text(group_recommendation_title),"请核对目标群，再确认进入（剩余 "));
    assert(lv_obj_has_state(group_recommendation_submit,LV_STATE_DISABLED));
    check_recommendation_cards();preview("voice-target-choices");
    tap_center(group_recommendation_cards[0]);
    assert(group_recommendation_selected==0&&recommendation_calls==1);
    assert(!lv_obj_has_state(group_recommendation_submit,LV_STATE_DISABLED));
    check_recommendation_cards();preview("voice-target-selected");
    tap_center(group_recommendation_submit);
    assert(recommendation_calls==2&&recommendation_action==GROUP_RECOMMENDATION_CONFIRM&&recommendation_revision==33);
    preview("voice-target-confirming");
    view.phase=GROUP_RECOMMENDATION_IDLE;view.revision=36;view.count=0;
    view.can_start=true;view.can_cancel=view.can_confirm=false;view.expires_remaining_ms=0;
    assert(board_display_set_group_recommendation(&view,NULL)==ESP_OK);
    assert(board_display_set_group_command_state(36,false,false,false,"")==ESP_OK);
    tap_center(group_recommendation_cancel);assert(group_modal==GROUP_MODAL_NONE);

    /* Accepted cancel must not flash a late candidate view or lose the origin
     * when intermediate controller revisions have already been published. */
    tap_center(group_voice_button);tap_center(group_command_submit);
    assert(recommendation_calls==3&&recommendation_revision==36&&group_voice_origin_revision==36);
    assert(board_display_set_group_command_state(37,false,true,true,"正在识别目标群")==ESP_OK);
    view=(group_recommendation_view_t){.phase=GROUP_RECOMMENDATION_LISTENING,.revision=37,.voice_mode=true,.can_cancel=true};
    assert(board_display_set_group_recommendation(&view,NULL)==ESP_OK);
    lv_obj_t *voice_overlay=group_command_overlay;
    tap_center(group_command_cancel);
    assert(recommendation_calls==4&&recommendation_action==GROUP_RECOMMENDATION_CANCEL&&recommendation_revision==36);
    assert(group_voice_cancelled);
    view.phase=GROUP_RECOMMENDATION_CHOOSING;view.revision=39;view.count=1;
    view.can_confirm=true;view.expires_remaining_ms=50000;
    assert(board_display_set_group_recommendation(&view,&item)==ESP_OK);
    assert(group_command_overlay==voice_overlay&&group_modal==GROUP_MODAL_VOICE);
    assert(group_recommendation_view.phase==GROUP_RECOMMENDATION_CLEANUP&&!group_recommendation_view.count);
    assert(!group_recommendation_view.can_confirm&&!group_recommendation_items&&!group_recommendation_cards[0]);
    assert(!strcmp(lv_label_get_text(group_command_title),"正在取消语音"));
    check_tree(group_command_overlay);preview("voice-target-cancelling");
    assert(board_display_set_group_command_state(40,false,false,false,"")==ESP_OK);
    view.phase=GROUP_RECOMMENDATION_IDLE;view.revision=40;view.count=0;
    view.can_start=true;view.can_cancel=view.can_confirm=false;view.expires_remaining_ms=0;
    assert(board_display_set_group_recommendation(&view,NULL)==ESP_OK);
    tap_center(group_command_cancel);assert(group_modal==GROUP_MODAL_NONE);

    /* The shared chooser's cancel also uses the original voice admission,
     * despite deletion of the old overlay during the handoff. */
    tap_center(group_voice_button);tap_center(group_command_submit);
    assert(recommendation_calls==5&&recommendation_revision==40);
    assert(board_display_set_group_command_state(41,false,true,true,"处理中")==ESP_OK);
    view.phase=GROUP_RECOMMENDATION_CHOOSING;view.revision=43;view.count=1;
    view.can_start=false;view.can_cancel=view.can_confirm=true;view.expires_remaining_ms=50000;
    assert(board_display_set_group_recommendation(&view,&item)==ESP_OK);
    assert(group_modal==GROUP_MODAL_RECOMMENDATION&&group_recommendation_origin_revision==40);
    tap_center(group_recommendation_cancel);
    assert(recommendation_calls==6&&recommendation_action==GROUP_RECOMMENDATION_CANCEL&&recommendation_revision==40);
    view.revision=44;
    assert(board_display_set_group_recommendation(&view,&item)==ESP_OK);
    assert(group_recommendation_view.phase==GROUP_RECOMMENDATION_CLEANUP&&!group_recommendation_cards[0]);
    assert(!group_recommendation_view.can_confirm&&!group_recommendation_items);
    view.phase=GROUP_RECOMMENDATION_IDLE;view.revision=45;view.count=0;
    view.can_start=true;view.can_cancel=view.can_confirm=false;view.expires_remaining_ms=0;
    assert(board_display_set_group_recommendation(&view,NULL)==ESP_OK);
    assert(board_display_set_group_command_state(45,false,false,false,"")==ESP_OK);
    tap_center(group_recommendation_cancel);assert(group_modal==GROUP_MODAL_NONE);

    /* Leaving the visible voice intent cancels with its admission token; late
     * results may update state but must not recreate a chooser. */
    tap_center(group_voice_button);tap_center(group_command_submit);
    assert(recommendation_calls==7&&recommendation_revision==45);
    assert(board_display_set_group_command_state(46,false,true,true,"处理中")==ESP_OK);
    lv_obj_send_event(lv_screen_active(),LV_EVENT_SCREEN_UNLOAD_START,NULL);
    assert(recommendation_calls==8&&recommendation_action==GROUP_RECOMMENDATION_CANCEL&&recommendation_revision==45);
    assert(group_modal==GROUP_MODAL_NONE&&!group_command_overlay);
    view.phase=GROUP_RECOMMENDATION_CHOOSING;view.revision=48;view.count=1;
    view.can_start=false;view.can_cancel=view.can_confirm=true;view.expires_remaining_ms=50000;
    assert(board_display_set_group_recommendation(&view,&item)==ESP_OK);
    assert(group_modal==GROUP_MODAL_NONE&&!group_command_overlay&&recommendation_calls==8);
    puts("Voice proposal UI: visible voice-to-chooser handoff, preserved admission token, explicit selection/confirm, cancel intent masks late choices and screen unload never reopens passed.");
    return true;
}
int main(int argc, char **argv) {
    lv_init();
    lv_display_t *display = lv_display_create(800, 480);
    static uint8_t pixels[800 * 20 * 4];
    lv_display_set_buffers(display, pixels, NULL, sizeof(pixels), LV_DISPLAY_RENDER_MODE_PARTIAL);
    lv_display_set_flush_cb(display, flush);
    pointer = lv_indev_create();
    lv_indev_set_type(pointer, LV_INDEV_TYPE_POINTER);
    lv_indev_set_display(pointer, display);
    lv_indev_set_read_cb(pointer, read_pointer);
    lv_indev_set_mode(pointer, LV_INDEV_MODE_EVENT);
    if(argc == 3 && !strcmp(argv[1], "--preview-dir")) preview_directory = argv[2];
    const char *only = argc > 1 && !preview_directory ? argv[1] : NULL;
    if((!only || !strcmp(only, "join")) && !test_join()) return EXIT_FAILURE;
    if((!only || !strcmp(only, "wifi")) && !test_wifi()) return EXIT_FAILURE;
    if(!only && !test_voice()) return EXIT_FAILURE;
    if(!only && !test_volume()) return EXIT_FAILURE;
    if(!only && !test_group_page()) return EXIT_FAILURE;
    if(!only && !test_recommendation()) return EXIT_FAILURE;
    if(!only && !test_voice_proposals()) return EXIT_FAILURE;
    lv_deinit();
    return EXIT_SUCCESS;
}
