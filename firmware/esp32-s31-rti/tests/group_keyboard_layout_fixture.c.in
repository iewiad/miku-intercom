typedef int esp_err_t;
#define ESP_OK 0
#define ESP_ERR_INVALID_STATE 1
#define ESP_ERR_TIMEOUT 2
#define ESP_ERR_INVALID_ARG 3
#define ESP_ERR_NO_MEM 4
#include "group_recommendation.h"
#define MALLOC_CAP_SPIRAM 1
#define MALLOC_CAP_8BIT 2
static bool psram_fail;
static unsigned psram_allocations;
static void *heap_caps_malloc(size_t size, int caps) {
    assert(caps == (MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
    ++psram_allocations; return psram_fail ? NULL : malloc(size);
}
#if !defined(__APPLE__) && !defined(__FreeBSD__)
static size_t strlcpy(char *dst, const char *src, size_t cap) {
    size_t size = strlen(src);
    if(cap) { size_t n = size < cap - 1 ? size : cap - 1; memcpy(dst, src, n); dst[n] = 0; }
    return size;
}
#endif
