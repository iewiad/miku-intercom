static esp_err_t refresh_state(bool join) {
 assert(!join);
 if(confirm_during_poll) {
  confirm_during_poll=false;
  assert(group_controller_recommendation_action(GROUP_RECOMMENDATION_CONFIRM,1,command.revision,NULL)==ESP_OK);
 }
 if(change_candidates_on_poll)++view_generation;
 if(expire_during_poll)now_us+=61000000;
 return refresh_result;
}
