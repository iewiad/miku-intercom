/* @production-app-boot */
static void verify_initial_volume(void) {
 const uint8_t levels[]={0,30,55,100};
 assert(group_controller_init(NULL)==ESP_ERR_INVALID_STATE);
 for(unsigned has_wifi=0;has_wifi<2;++has_wifi) {
 for(size_t i=0;i<sizeof(levels)/sizeof(levels[0]);++i) {
  worker=NULL;volume_calls=persist_calls=0;display_volume_callback=NULL;
  saved_wifi=has_wifi;loaded_volume=levels[i];wifi_setup_callback=NULL;wifi_setup_context=NULL;
  app_main();
  if(!saved_wifi) {
   assert(!worker&&wifi_setup_callback&&wifi_setup_context==&board_audio);
   assert(wifi_setup_callback(wifi_setup_context)==ESP_OK);
  }
  assert(volume_calls==1&&persist_calls==0&&display_volume==levels[i]);
  assert(audio.output_volume==levels[i]&&board_audio.output_volume==levels[i]);
  group_controller_print_status();
  assert(!strncmp(status_output,"INTERCOM_STATUS ",16));cJSON *status=cJSON_Parse(status_output+16);assert(status);
  assert(cJSON_IsNumber(cJSON_GetObjectItemCaseSensitive(status,"output_volume")));
  assert(cJSON_GetObjectItemCaseSensitive(status,"output_volume")->valueint==levels[i]);
  assert(cJSON_HasObjectItem(status,"connected")&&cJSON_HasObjectItem(status,"current_version"));cJSON_Delete(status);
  assert(display_volume_callback);display_volume_callback(41,false,NULL);
  assert(volume_calls==2&&persist_calls==0&&audio.output_volume==41);
  display_volume_callback(30,true,NULL);assert(volume_calls==3&&persist_calls==1&&audio.output_volume==30);
 }
 }
 worker=NULL;
}
static void expect_configured(bool expected) {
 const unsigned checks=config_checks,loads=config_loads,allocations=status_allocations;
 status_sampling=true;
 for(unsigned i=0;i<100;++i)group_controller_print_status();
 status_sampling=false;
 assert(config_checks==checks&&config_loads==loads&&status_allocations==allocations&&!guard_depth);
 assert(!strstr(status_output,"active_identity")&&!strstr(status_output,"loaded_identity"));
 cJSON *status=cJSON_Parse(status_output+16);assert(status);
 const cJSON *configured=cJSON_GetObjectItemCaseSensitive(status,"configured");
 assert(cJSON_IsBool(configured)&&cJSON_IsTrue(configured)==expected);cJSON_Delete(status);
}
static void verify_config_status(void) {
 worker=NULL;stored_configured=false;saved_config_present=false;
 config_checks=config_loads=config_writes=status_allocations=0;
 expect_configured(false);assert(!config_checks&&!config_loads);
 board_audio_t board={.microphone=&task_object,.speaker=&mutex_object,.output_volume=30};
 assert(group_controller_init(&board)==ESP_OK);assert(config_checks==1);
 assert(strstr(last_detail,"USB"));expect_configured(false);
 strlcpy(config.device_id,"active_identity",sizeof(config.device_id));
 handle_intercom_config("fixture_encoded_config");
 assert(config_writes==1&&config_checks==2&&!strcmp(config.device_id,"active_identity"));
 expect_configured(true);
 // Rejected/failed saves revalidate the old durable config. An ambiguous
 // failure whose readable result is absent must not retain a previous true.
 config_write_result=ESP_FAIL;handle_intercom_config("fixture_encoded_config");
 assert(config_writes==2&&config_checks==3);expect_configured(true);
 remove_config_on_failed_write=true;handle_intercom_config("fixture_encoded_config");
 assert(config_writes==3&&config_checks==4);expect_configured(false);
 handle_intercom_config("invalid_encoding");
 assert(config_writes==3&&config_checks==4);expect_configured(false);
 config_write_result=ESP_OK;remove_config_on_failed_write=false;
 handle_intercom_config("fixture_encoded_config");expect_configured(true);
 intent.desired=intent.ready=intent.pressed=intent.held=true;
 group_controller_action(true,NULL);
 assert(!intent.desired&&!intent.ready&&!intent.pressed&&!intent.held);expect_configured(true);
 // Exercise the same worker load helper used by run(), including a newer
 // explicit refresh interrupting an old successful verification.
 config_load_result=ESP_FAIL;assert(load_config()==ESP_FAIL);expect_configured(false);
 config_load_result=ESP_OK;assert(load_config()==ESP_OK);expect_configured(true);
 refresh_during_load=true;assert(load_config()==ESP_OK);expect_configured(false);
 saved_config_present=true;refresh_during_check=true;
 group_controller_refresh_config_status();expect_configured(false);
 saved_config_present=true;worker=NULL;
 const unsigned before=config_checks;
 assert(group_controller_init(&board)==ESP_OK&&config_checks==before+1);expect_configured(true);
 worker=NULL;
}
static void reset(void) {
 proposal_posts=0;proposal_source="exact";
 memset(&intent,0,sizeof(intent));memset(&command,0,sizeof(command));memset(&config,0,sizeof(config));
 memset(&command_session,0,sizeof(command_session));command_session_live=command_peer_live=false;
 command_deadline_us=command_cleanup_retry_us=0;now_us=1000000;command_target[0]=command_result[0]=0;
 intent.desired=intent.ready=true;catalog_known=true;view_generation=4;
 strlcpy(published_group_id,"grp_aaaa",81);strlcpy(group_id,"grp_aaaa",81);strlcpy(peer_id,"old_group_peer",81);
 strlcpy(config.server_url,"https://fixture.invalid",sizeof(config.server_url));strlcpy(config.device_id,"fixture_device",sizeof(config.device_id));
 published_version=version=7;strlcpy(items[0].id,"grp_aaaa",81);strlcpy(items[1].id,"grp_bbbb",81);catalog_count=2;
 selection_queued=pending_saved=journal_blocked=false;switch_phase=SWITCH_IDLE;
 notifications=disconnects=release_calls=create_calls=start_calls=peer_stops=stop_calls=gate_calls=requests=join_posts=resolve_posts=journal_saves=stop_failures=0;
 create_result=start_result=request_result=ESP_OK;
 create_error_with_id=cancel_in_create=cancel_in_resolve=stop_during_release=stop_after_submit=false;
 strlcpy(resolved_target,"grp_bbbb",81);seen_transcript[0]=last_detail[0]=0;
 last_resolve_log[0]=0;last_http_status=0;last_voice_api_error=GROUP_VOICE_API_NONE;
 injected_voice_api_error=GROUP_VOICE_API_OTHER;injected_voice_http_status=422;
 retained_stops=recommend_posts=capability_gets=0;
 cancel_in_recommend=cancel_before_recommend_post=change_candidates_on_poll=fail_recommend_alloc=false;
 capability_available=true;refresh_result=ESP_OK;
 confirm_during_poll=expire_during_poll=false;
 recommendation_deadline_us=recommendation_next_poll_us=0;strlcpy(server_epoch,"epoch_fixture",81);
 if(recommendation)memset(recommendation,0,sizeof(*recommendation));
 if(recommendation_need)memset(recommendation_need,0,GROUP_RECOMMENDATION_NEED_BYTES+1);
}
static void begin_voice(void) {
 assert(group_controller_voice_action(false,NULL)==ESP_OK);
 assert(command.kind==GROUP_COMMAND_VOICE&&intent.command_busy&&!intent.ready);
 assert(process_command());assert(command.phase==GROUP_COMMAND_LISTENING);
 assert(disconnects==1&&create_calls==1&&start_calls==1);
}
static void final_event(uint32_t ticket,const char *text) {
 webrtc_command_event_t event={.type=WEBRTC_COMMAND_FINAL,.generation=ticket};strlcpy(event.text,text,sizeof(event.text));command_event(&event,NULL);
}
static void begin_recommendation(void) {
 assert(group_controller_recommendation_action(GROUP_RECOMMENDATION_START,0,command.revision,NULL)==ESP_OK);
 assert(command.kind==GROUP_COMMAND_RECOMMEND&&intent.command_busy&&!intent.ready);
 assert(process_command()&&command.phase==GROUP_COMMAND_LISTENING&&command.need);
 final_event(command.ticket,"fixture need");assert(command.phase==GROUP_COMMAND_RESOLVING);
 assert(process_command()&&command.phase==GROUP_COMMAND_CLEANUP&&!recommend_posts&&!resolve_posts);
 assert(!command_deadline_us); // RTA's 45s budget cannot expire model/review.
}
static void choose_recommendation(void) {
 begin_recommendation();
 assert(process_command()&&command.phase==GROUP_COMMAND_REQUESTING&&!recommend_posts);
 assert(process_command()&&command.phase==GROUP_COMMAND_CHOOSING&&recommend_posts==1);
 assert(!command.need[0]&&recommendation->count==2&&!journal_saves&&!selection_queued);
}
static void *no_cjson_memory(size_t size) {(void)size;return NULL;}
int main(void) {
 verify_config_status();
 verify_initial_volume();
 // UI admission revision can cancel before any worker publication, including
 // after the worker has advanced phases; an earlier command's origin cannot.
 reset();uint32_t origin=command.revision;
 assert(group_controller_recommendation_action(GROUP_RECOMMENDATION_START_VOICE,0,origin,NULL)==ESP_OK);
 assert(command.origin_revision==origin);
 assert(group_controller_recommendation_action(GROUP_RECOMMENDATION_CANCEL,0,origin,NULL)==ESP_OK);
 assert(!process_command()&&!create_calls&&!proposal_posts);
 intent.ready=true;assert(!process_command());uint32_t newer=command.revision;
 assert(group_controller_recommendation_action(GROUP_RECOMMENDATION_START_VOICE,0,newer,NULL)==ESP_OK);
 assert(group_controller_recommendation_action(GROUP_RECOMMENDATION_CANCEL,0,origin,NULL)==ESP_ERR_INVALID_STATE);
 assert(process_command()&&command.phase==GROUP_COMMAND_LISTENING);
 assert(group_controller_recommendation_action(GROUP_RECOMMENDATION_CANCEL,0,newer,NULL)==ESP_OK);
 assert(!process_command()&&!proposal_posts&&!journal_saves);
 reset();capability_available=false;begin_voice();const uint32_t first_ticket=command.ticket;
 final_event(first_ticket,"切到乙群");final_event(first_ticket,"切到甲群");
 assert(command.phase==GROUP_COMMAND_RESOLVING&&!strcmp(command.transcript,"切到乙群"));
 assert(process_command()&&command.phase==GROUP_COMMAND_CLEANUP&&!proposal_posts&&!resolve_posts);
 assert(!command_target[0]&&!selection_queued&&!journal_saves&&!capability_gets);
 // No proposal request until local retirement and remote terminal confirmation.
 retained_stops=1;stop_failures=2;
 assert(process_command()&&command_peer_live&&!stop_calls&&!proposal_posts);
 assert(process_command()&&!command_peer_live&&stop_calls==1&&!proposal_posts);
 assert(process_command()&&stop_calls==1);now_us+=2000000;
 assert(process_command()&&stop_calls==2&&!proposal_posts);now_us+=2000000;
 assert(process_command()&&stop_calls==3&&command.phase==GROUP_COMMAND_REQUESTING&&!proposal_posts);
 assert(process_command()&&command.phase==GROUP_COMMAND_CHOOSING&&proposal_posts==1);
 assert(!strcmp(seen_transcript,"切到乙群")&&!command.transcript[0]&&!command_target[0]);
 assert(recommendation->source==GROUP_RECOMMENDATION_SOURCE_EXACT&&!command.submitted&&!journal_saves&&!selection_queued);
 assert(strstr(last_resolve_log,"accepted=1 source=exact candidates=1"));
 assert(!strstr(last_resolve_log,"乙群")&&!strstr(last_resolve_log,"grp_bbbb"));
 uint32_t voice_review=command.revision;
 assert(group_controller_recommendation_action(GROUP_RECOMMENDATION_CONFIRM,0,voice_review-1,NULL)==ESP_ERR_INVALID_STATE);
 assert(group_controller_recommendation_action(GROUP_RECOMMENDATION_CONFIRM,1,voice_review,NULL)==ESP_ERR_INVALID_STATE);
 assert(process_command()&&!journal_saves&&!command.submitted); // viewing does not execute exact targets
 assert(group_controller_recommendation_action(GROUP_RECOMMENDATION_CONFIRM,0,voice_review,NULL)==ESP_OK);
 assert(command.submitted&&command.phase==GROUP_COMMAND_CONFIRMING&&!journal_saves);
 assert(group_controller_recommendation_action(GROUP_RECOMMENDATION_CANCEL,0,command.revision,NULL)==ESP_ERR_INVALID_STATE);
 assert(!process_command()&&pending_saved&&journal_saves==1&&!selection_queued);
 assert(!strcmp(saved_record.group_id,"grp_bbbb")&&!strcmp(saved_record.recommendation_id,"voice_fixture"));
 assert(saved_record.expected_version==7&&!strcmp(saved_record.recommendation_epoch,"epoch_fixture"));
 pending_saved=false;intent.switch_pending=false;intent.ready=true;
 assert(!process_command()&&command.kind==GROUP_COMMAND_NONE&&!intent.command_busy);
 uint32_t terminal_revision=command.revision;final_event(first_ticket,"late final");assert(command.revision==terminal_revision);
 // Model proposals use the same explicit confirmation and cancellation gates.
 reset();proposal_source="model";begin_voice();final_event(command.ticket,"去适合的乙群");
 assert(process_command()&&process_command()&&process_command());
 assert(command.phase==GROUP_COMMAND_CHOOSING&&recommendation->source==GROUP_RECOMMENDATION_SOURCE_MODEL);
 assert(!journal_saves&&!command.submitted&&!command_target[0]);
 assert(group_controller_recommendation_action(GROUP_RECOMMENDATION_CANCEL,0,command.revision,NULL)==ESP_OK);
 assert(!process_command()&&!journal_saves&&!selection_queued);
 // Cancel during model HTTP or immediately before admission discards late candidates.
 reset();begin_voice();final_event(command.ticket,"切到乙群");assert(process_command()&&process_command());cancel_in_resolve=true;
 assert(process_command()&&command.phase==GROUP_COMMAND_RECOVERING&&command.cancelled&&!journal_saves);
 assert(!command_target[0]&&!command.transcript[0]);
 reset();begin_voice();final_event(command.ticket,"切到乙群");assert(process_command()&&process_command());cancel_before_recommend_post=true;
 assert(process_command()&&!proposal_posts&&command.phase==GROUP_COMMAND_RECOVERING&&!journal_saves);
 // The same freshness/expiry/member guards apply to voice proposals.
 for(unsigned guard_case=0;guard_case<3;++guard_case) {
  reset();begin_voice();final_event(command.ticket,"切到乙群");assert(process_command()&&process_command()&&process_command());
  if(guard_case==0)++published_version;
  if(guard_case==1)++view_generation;
  if(guard_case==2)now_us+=61000000;
  assert(group_controller_recommendation_action(GROUP_RECOMMENDATION_CONFIRM,0,command.revision,NULL)==ESP_ERR_INVALID_STATE);
  assert(!journal_saves&&!command.submitted);
 }
 reset();proposal_source="model";begin_voice();final_event(command.ticket,"请找乙群");
 assert(process_command()&&process_command()&&process_command()&&command.phase==GROUP_COMMAND_CHOOSING);
 assert(group_controller_recommendation_action(GROUP_RECOMMENDATION_CONFIRM,0,command.revision,NULL)==ESP_OK);
 intent.desired=false;assert(!process_command()&&pending_saved&&journal_saves==1);
 assert(!strcmp(saved_record.group_id,"grp_bbbb")&&!strcmp(saved_record.recommendation_id,"voice_fixture"));
 // Invalid source, outside-membership response and transport/API failures never execute.
 for(unsigned failure=0;failure<6;++failure) {
  reset();begin_voice();final_event(command.ticket,"private utterance");assert(process_command()&&process_command());
  if(failure==0)proposal_source="unknown";
  if(failure==1)proposal_source=NULL;
  if(failure==2)strlcpy(resolved_target,"grp_unknown",81);
  if(failure>=3){request_result=ESP_FAIL;injected_voice_http_status=failure==3?400:failure==4?503:0;}
  assert(process_command()&&command.phase==GROUP_COMMAND_RECOVERING&&!journal_saves&&!command_target[0]);
  assert(!command.transcript[0]&&!strstr(last_resolve_log,"private")&&!strstr(last_resolve_log,"grp_"));
 }
 // JSON allocation failure must not reuse stale HTTP metadata or send any body.
 reset();begin_voice();final_event(command.ticket,"切到乙群");assert(process_command()&&process_command());last_http_status=200;
 cJSON_Hooks hooks={.malloc_fn=no_cjson_memory,.free_fn=free};cJSON_InitHooks(&hooks);assert(process_command());cJSON_InitHooks(NULL);
 assert(!proposal_posts&&strstr(last_resolve_log,"requested=0 http=0")&&!journal_saves);
 reset();assert(group_controller_voice_action(false,NULL)==ESP_OK);assert(group_controller_voice_action(true,NULL)==ESP_OK);
 assert(!process_command()&&!create_calls&&!proposal_posts&&!selection_queued&&peer_id[0]==0);
 intent.ready=true;assert(!process_command()&&command.kind==GROUP_COMMAND_NONE);
 reset();cancel_in_create=true;assert(group_controller_voice_action(false,NULL)==ESP_OK);assert(process_command());
 assert(create_calls==1&&!start_calls);assert(!process_command()&&stop_calls==1&&!proposal_posts);
 // Failed create with known handle still requires remote cleanup; no handle cannot fabricate it.
 reset();create_result=ESP_FAIL;create_error_with_id=true;stop_failures=1;
 assert(group_controller_voice_action(false,NULL)==ESP_OK);assert(process_command());
 assert(command.failed&&command_session_live&&!start_calls);assert(process_command()&&stop_calls==1&&command_session_live);
 now_us+=2000000;assert(!process_command()&&stop_calls==2&&!command_session_live&&!proposal_posts);
 reset();create_result=ESP_FAIL;assert(group_controller_voice_action(false,NULL)==ESP_OK);assert(process_command());
 assert(!command_session_live&&!start_calls);assert(!process_command()&&!stop_calls&&!proposal_posts);
 reset();start_result=ESP_FAIL;assert(group_controller_voice_action(false,NULL)==ESP_OK);assert(process_command());
 assert(command.failed&&command.phase==GROUP_COMMAND_CLEANUP);assert(!process_command()&&peer_stops==1&&stop_calls==1&&!proposal_posts);
 reset();begin_voice();now_us+=46000000;assert(!process_command()&&command.cancelled&&!proposal_posts);
 // A previous command's final cannot satisfy a later command's listener.
 reset();begin_voice();uint32_t old_ticket=command.ticket;
 assert(group_controller_voice_action(true,NULL)==ESP_OK);assert(!process_command());
 intent.ready=true;assert(!process_command());strlcpy(peer_id,"restored_group_peer",81);
 assert(group_controller_voice_action(false,NULL)==ESP_OK);assert(process_command());
 final_event(old_ticket,"切到乙群");assert(command.phase==GROUP_COMMAND_LISTENING);
 assert(group_controller_voice_action(true,NULL)==ESP_OK);assert(!process_command());
 // Join validates/erases copied input; STOP before submit prevents POST.
 reset();assert(group_controller_join_group("abcdefg2",NULL)==ESP_OK);
 assert(command.kind==GROUP_COMMAND_JOIN&&intent.command_busy);
 assert(process_command());assert(join_posts==1&&command.kind==GROUP_COMMAND_NONE&&command.code[0]==0&&!intent.command_busy);
 reset();assert(group_controller_join_group("ABCDEFG2",NULL)==ESP_OK);stop_during_release=true;
 assert(process_command());assert(join_posts==0&&command.kind==GROUP_COMMAND_NONE);
 reset();assert(group_controller_join_group("ABCDEFG2",NULL)==ESP_OK);stop_after_submit=true;
 assert(process_command());assert(join_posts==1&&!intent.desired&&command.kind==GROUP_COMMAND_NONE);
 reset();begin_recommendation();retained_stops=1;stop_failures=1;
 assert(process_command()&&command_peer_live&&!stop_calls&&!recommend_posts);
 assert(process_command()&&!command_peer_live&&command_session_live&&stop_calls==1&&!recommend_posts);
 now_us+=2000000;assert(process_command()&&!command_session_live&&command.phase==GROUP_COMMAND_REQUESTING&&!recommend_posts);
 assert(process_command()&&command.phase==GROUP_COMMAND_CHOOSING&&recommend_posts==1);
 uint32_t review=command.revision;
 assert(process_command()&&command.revision==review); // A view/countdown refresh is not a new revision.
 assert(group_controller_recommendation_action(GROUP_RECOMMENDATION_CONFIRM,0,review-1,NULL)==ESP_ERR_INVALID_STATE);
 assert(group_controller_recommendation_action(GROUP_RECOMMENDATION_CONFIRM,3,review,NULL)==ESP_ERR_INVALID_STATE);
 assert(!journal_saves&&!selection_queued);
 // Explicitly confirming the already-current group still consumes through the
 // recommendation journal; no ordinary same-group fast path may substitute.
 assert(group_controller_recommendation_action(GROUP_RECOMMENDATION_CONFIRM,0,review,NULL)==ESP_OK);
 assert(command.submitted&&command.phase==GROUP_COMMAND_CONFIRMING&&!journal_saves);
 assert(group_controller_recommendation_action(GROUP_RECOMMENDATION_CANCEL,0,command.revision,NULL)==ESP_ERR_INVALID_STATE);
 intent.desired=false;assert(!process_command()&&pending_saved&&journal_saves==1&&!selection_queued);
 assert(!strcmp(saved_record.group_id,"grp_aaaa")&&!strcmp(saved_record.recommendation_id,"recommend_fixture"));
 assert(!strcmp(saved_record.recommendation_epoch,"epoch_fixture")&&saved_record.expected_version==7);
 reset();choose_recommendation();review=command.revision;
 assert(group_controller_recommendation_action(GROUP_RECOMMENDATION_CANCEL,0,review,NULL)==ESP_OK);
 assert(!process_command()&&command.phase==GROUP_COMMAND_RECOVERING&&!journal_saves&&!selection_queued);
 reset();choose_recommendation();now_us+=61000000;
 assert(!process_command()&&command.phase==GROUP_COMMAND_RECOVERING&&!journal_saves);
 reset();choose_recommendation();change_candidates_on_poll=true;now_us+=1000001;
 assert(!process_command()&&command.phase==GROUP_COMMAND_RECOVERING&&!journal_saves);
 reset();choose_recommendation();refresh_result=ESP_FAIL;now_us+=1000001;
 assert(!process_command()&&command.phase==GROUP_COMMAND_RECOVERING&&!journal_saves);
 reset();begin_recommendation();assert(process_command());cancel_in_recommend=true;
 assert(process_command()&&command.phase==GROUP_COMMAND_RECOVERING&&!journal_saves&&!command.need[0]);
 reset();begin_recommendation();assert(process_command());request_result=ESP_FAIL;
 assert(process_command()&&command.phase==GROUP_COMMAND_RECOVERING&&!journal_saves&&!command.need[0]);
 reset();begin_recommendation();assert(process_command());cancel_before_recommend_post=true;
 assert(process_command()&&command.phase==GROUP_COMMAND_RECOVERING&&!recommend_posts&&!journal_saves&&!command.need[0]);
 reset();capability_available=false;
 assert(group_controller_recommendation_action(GROUP_RECOMMENDATION_START,0,command.revision,NULL)==ESP_OK);
 assert(!process_command()&&command.phase==GROUP_COMMAND_RECOVERING&&capability_gets==1);
 assert(!create_calls&&!start_calls&&!recommend_posts&&!journal_saves);
 reset();request_result=ESP_FAIL;
 assert(group_controller_recommendation_action(GROUP_RECOMMENDATION_START,0,command.revision,NULL)==ESP_OK);
 assert(!process_command()&&command.phase==GROUP_COMMAND_RECOVERING&&!create_calls&&!start_calls&&!recommend_posts&&!journal_saves);
 // A stale CHOOSING stack frame may not retract a CONFIRM admitted while its
 // state request was in flight, regardless of the response/error/deadline.
 for(unsigned race=0;race<3;++race) {
  reset();choose_recommendation();now_us+=1000001;confirm_during_poll=true;
  if(race==0)refresh_result=ESP_FAIL;
  if(race==1)change_candidates_on_poll=true;
  if(race==2)expire_during_poll=true;
  assert(process_command()&&command.phase==GROUP_COMMAND_CONFIRMING&&command.submitted&&!journal_saves);
  assert(!process_command()&&pending_saved&&journal_saves==1&&command.phase==GROUP_COMMAND_RECOVERING);
  assert(!strcmp(saved_record.group_id,"grp_bbbb")&&!strcmp(saved_record.recommendation_id,"recommend_fixture"));
  assert(!strcmp(saved_record.recommendation_epoch,"epoch_fixture")&&saved_record.expected_version==7);
 }
 free(recommendation);recommendation=NULL;free(recommendation_need);recommendation_need=NULL;
 puts("controller command flow: passed (RAM-only status, config init/save/load/STOP and stale validation, saved volume, first final, stop ACK retry, late event, cancel, journal handoff)");
 return 0;
}
