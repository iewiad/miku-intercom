bool group_config_ready(void) {
 assert(!guard_depth&&!status_sampling);++config_checks;
 const bool result=saved_config_present;
 if(refresh_during_check) {
  refresh_during_check=false;saved_config_present=false;group_controller_refresh_config_status();
 }
 return result;
}
esp_err_t group_config_load(group_config_t *out) {
 assert(!guard_depth&&!status_sampling&&out==&config);++config_loads;
 strlcpy(out->device_id,"loaded_identity",sizeof(out->device_id));
 if(refresh_during_load) {
  refresh_during_load=false;saved_config_present=false;group_controller_refresh_config_status();
 }
 return config_load_result;
}
esp_err_t group_config_store_json(const char *json,size_t size) {
 assert(!guard_depth&&!status_sampling&&size==2&&!memcmp(json,"{}",2));++config_writes;
 if(config_write_result==ESP_OK)saved_config_present=true;
 else if(remove_config_on_failed_write)saved_config_present=false;
 return config_write_result;
}
static bool hex_decode(const char *hex,uint8_t *out,size_t capacity,size_t *size) {
 if(strcmp(hex,"fixture_encoded_config"))return false;
 assert(capacity>=3);memcpy(out,"{}",3);*size=2;return true;
}
static void *tracked_calloc(size_t count,size_t size) {
 if(status_sampling)++status_allocations;return calloc(count,size);
}
static __attribute__((unused)) void *tracked_malloc(size_t size) {
 if(status_sampling)++status_allocations;return malloc(size);
}
static void tracked_free(void *pointer) {
 if(status_sampling)++status_allocations;free(pointer);
}
