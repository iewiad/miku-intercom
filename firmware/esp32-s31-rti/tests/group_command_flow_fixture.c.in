static void cancel_locked(void) {intent.pressed=false;intent.held=false;++intent.generation;}
static bool update_ui(const char *detail) {
 if(detail)strlcpy(last_detail,detail,sizeof(last_detail));ui_revision=command.revision;ui_busy=command.kind!=GROUP_COMMAND_NONE;
 if(cancel_before_recommend_post&&command.phase==GROUP_COMMAND_REQUESTING) {
  cancel_before_recommend_post=false;
  assert(group_controller_recommendation_action(GROUP_RECOMMENDATION_CANCEL,0,command.revision,NULL)==ESP_OK);
 }
 return true;
}
static void release_floor(void) {++release_calls;cancel_locked();if(stop_during_release)intent.desired=false;}
static void disconnect_peer(void) {++disconnects;intent.ready=false;release_floor();peer_id[0]=0;}
static esp_err_t reject_state(esp_err_t err) {intent.ready=false;catalog_known=false;return err;}
static esp_err_t apply_state(const cJSON *state,int64_t started,int64_t ended) {(void)started;(void)ended;return cJSON_IsObject(state)?ESP_OK:ESP_ERR_INVALID_RESPONSE;}
static esp_err_t request(const char *path,int method,const cJSON *body,cJSON **out) {
 if(method==HTTP_METHOD_GET) {
  assert(!strcmp(path,"/recommendations")&&!body);++capability_gets;
  *out=cJSON_CreateObject();cJSON_AddBoolToObject(*out,"available",capability_available);return request_result;
 }
 assert(method==HTTP_METHOD_POST);++requests;
 last_voice_api_error=GROUP_VOICE_API_NONE;
 if(!strcmp(path,"/memberships")) {
  ++join_posts;const cJSON *code=cJSON_GetObjectItemCaseSensitive(body,"code");assert(cJSON_IsString(code)&&strlen(code->valuestring)==8);
  if(stop_after_submit)intent.desired=false;
  last_http_status=request_result==ESP_OK?200:429;
  if(request_result==ESP_OK&&out)*out=cJSON_Parse("{\"state\":{}}");
 } else if(!strcmp(path,"/voice/proposals")) {
  assert(!command_peer_live&&!command_session_live);++proposal_posts;
  last_http_status=request_result==ESP_OK?200:injected_voice_http_status;
  const cJSON *text=cJSON_GetObjectItemCaseSensitive(body,"transcript");assert(cJSON_IsString(text));
  assert(cJSON_IsString(cJSON_GetObjectItemCaseSensitive(body,"request_id")));
  assert(cJSON_IsString(cJSON_GetObjectItemCaseSensitive(body,"server_epoch")));
  assert(cJSON_GetObjectItemCaseSensitive(body,"expected_version")->valuedouble==7);
  strlcpy(seen_transcript,text->valuestring,sizeof(seen_transcript));
  if(cancel_in_resolve)assert(group_controller_voice_action(true,NULL)==ESP_OK);
  if(request_result==ESP_OK&&out) {
   *out=cJSON_Parse("{\"recommendation\":{\"recommendation_id\":\"voice_fixture\",\"request_id\":\"fixture_operation\",\"server_epoch\":\"epoch_fixture\",\"current_version\":7,\"candidate_digest\":\"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\",\"expires_at\":\"test-clock-expiry\",\"suggestions\":[{\"group_id\":\"grp_bbbb\",\"name\":\"fixture beta\",\"purpose\":\"fixture purpose\",\"reason\":\"请核对识别出的目标群，确认后才会切换。\"}]}}");
   cJSON *record=cJSON_GetObjectItemCaseSensitive(*out,"recommendation");
   if(proposal_source)cJSON_AddStringToObject(record,"source",proposal_source);
   cJSON_SetValuestring(cJSON_GetObjectItemCaseSensitive(cJSON_GetArrayItem(cJSON_GetObjectItemCaseSensitive(record,"suggestions"),0),"group_id"),resolved_target);
  }
 } else if(!strcmp(path,"/voice/resolve")) {
  last_http_status=request_result==ESP_OK?200:injected_voice_http_status;
  last_voice_api_error=request_result==ESP_OK?GROUP_VOICE_API_NONE:injected_voice_api_error;
  ++resolve_posts;const cJSON *text=cJSON_GetObjectItemCaseSensitive(body,"transcript");assert(cJSON_IsString(text));
  strlcpy(seen_transcript,text->valuestring,sizeof(seen_transcript));
  if(cancel_in_resolve)assert(group_controller_voice_action(true,NULL)==ESP_OK);
  if(request_result==ESP_OK&&out) { *out=cJSON_CreateObject();assert(cJSON_AddStringToObject(*out,"group_id",resolved_target)); }
 } else if(!strcmp(path,"/recommendations")) {
  assert(!command_peer_live&&!command_session_live);++recommend_posts;
  assert(cJSON_IsString(cJSON_GetObjectItemCaseSensitive(body,"need")));
  if(cancel_in_recommend)assert(group_controller_recommendation_action(GROUP_RECOMMENDATION_CANCEL,0,command.revision,NULL)==ESP_OK);
  if(request_result==ESP_OK&&out) *out=cJSON_Parse("{\"recommendation\":{\"recommendation_id\":\"recommend_fixture\",\"request_id\":\"fixture_operation\",\"server_epoch\":\"epoch_fixture\",\"current_version\":7,\"candidate_digest\":\"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\",\"expires_at\":\"test-clock-expiry\",\"suggestions\":[{\"group_id\":\"grp_aaaa\",\"name\":\"fixture alpha\",\"reason\":\"fixture reason\"},{\"group_id\":\"grp_bbbb\",\"name\":\"fixture beta\",\"purpose\":\"fixture purpose\",\"reason\":\"fixture reason\"}]}}");
 } else assert(!"unexpected request");
 return request_result;
}
esp_err_t rti_session_create_command(rti_session_t *s) {
 ++create_calls;if(create_result==ESP_OK||create_error_with_id)strlcpy(s->session_id,"fake_session",sizeof(s->session_id));
 if(cancel_in_create)assert(group_controller_voice_action(true,NULL)==ESP_OK);
 return create_result;
}
