#include <assert.h>
#include <stdbool.h>
#include <stdint.h>
#include <stdio.h>
#include <string.h>
#include "cJSON.h"
#include "group_command_state.h"
#include "group_switch_journal.h"
#include "rti_session.h"
#include "rta_command_events.h"
#include "group_config.h"
#define portENTER_CRITICAL(p) ((void)(p))
#define portEXIT_CRITICAL(p) ((void)(p))
#define HTTP_METHOD_POST 1
#define strlcpy fixture_strlcpy
static size_t fixture_strlcpy(char *d,const char*s,size_t cap) { size_t n=strlen(s);if(cap){size_t m=n<cap-1?n:cap-1;memcpy(d,s,m);d[m]=0;}return n; }
/* @production-intent */
static int guard,audio;
static group_intent_t intent;
static group_command_state_t command;
static group_config_t config;
static rti_session_t command_session;
static bool command_session_live,command_peer_live;
static int64_t command_deadline_us,command_cleanup_retry_us,now_us;
static char command_target[81],command_result[160];
static uint64_t command_expected_version;
static bool catalog_known,selection_queued,pending_saved,journal_blocked;
static uint32_t view_generation;
static char published_group_id[81],selected_group_id[81],group_id[81],peer_id[81];
static uint64_t published_version,selected_expected_version,version;
static struct { char id[81],name[129]; } items[2];
static typeof(items[0]) *catalog_items=items;
static size_t catalog_count;
typedef enum { SWITCH_IDLE,SWITCH_QUEUED,SWITCH_CONFIRMING,SWITCH_MISMATCH,SWITCH_JOURNAL_ERROR } switch_phase_t;
static switch_phase_t switch_phase;
static char switch_operation_id[81],switch_target_id[81];
static group_switch_journal_t pending_operation,saved_record;
static int last_http_status;
static cJSON *floor_request;
static unsigned notifications,disconnects,release_calls,create_calls,start_calls,peer_stops,stop_calls,gate_calls,requests,join_posts,resolve_posts,journal_saves;
static unsigned stop_failures;
static esp_err_t create_result,start_result,request_result;
static bool create_error_with_id, cancel_in_create,cancel_in_resolve,stop_during_release,stop_after_submit;
static char resolved_target[81],seen_transcript[513],last_detail[192];
static uint32_t ui_revision;
static bool ui_busy;
static esp_err_t group_controller_voice_action(bool cancel,void *context);
static void command_event(const webrtc_command_event_t *,void *);
static int64_t esp_timer_get_time(void) {return now_us;}
static void mbedtls_platform_zeroize(void *p,size_t n) {volatile unsigned char *c=p;while(n--)*c++=0;}
static void notify_worker(void) {++notifications;}
static void webrtc_peer_command_cancel(void) {++gate_calls;}
static void webrtc_peer_group_suspend_media(void) {}
static void cancel_locked(void) {intent.pressed=false;intent.held=false;++intent.generation;}
static bool update_ui(const char *detail) {if(detail)strlcpy(last_detail,detail,sizeof(last_detail));ui_revision=command.revision;ui_busy=command.kind!=GROUP_COMMAND_NONE;return true;}
static void release_floor(void) {++release_calls;cancel_locked();if(stop_during_release)intent.desired=false;}
static void disconnect_peer(void) {++disconnects;intent.ready=false;release_floor();peer_id[0]=0;}
static esp_err_t reject_state(esp_err_t err) {intent.ready=false;catalog_known=false;return err;}
static esp_err_t apply_state(const cJSON *state,int64_t started,int64_t ended) {(void)started;(void)ended;return cJSON_IsObject(state)?ESP_OK:ESP_ERR_INVALID_RESPONSE;}
static esp_err_t request(const char *path,int method,const cJSON *body,cJSON **out) {
 assert(method==HTTP_METHOD_POST);++requests;
 if(!strcmp(path,"/memberships")) {
  ++join_posts;const cJSON *code=cJSON_GetObjectItemCaseSensitive(body,"code");assert(cJSON_IsString(code)&&strlen(code->valuestring)==8);
  if(stop_after_submit)intent.desired=false;
  last_http_status=request_result==ESP_OK?200:429;
  if(request_result==ESP_OK&&out)*out=cJSON_Parse("{\"state\":{}}");
 } else if(!strcmp(path,"/voice/resolve")) {
  ++resolve_posts;const cJSON *text=cJSON_GetObjectItemCaseSensitive(body,"transcript");assert(cJSON_IsString(text));
  strlcpy(seen_transcript,text->valuestring,sizeof(seen_transcript));
  if(cancel_in_resolve)assert(group_controller_voice_action(true,NULL)==ESP_OK);
  if(request_result==ESP_OK&&out) { *out=cJSON_CreateObject();assert(cJSON_AddStringToObject(*out,"group_id",resolved_target)); }
 } else assert(!"unexpected request");
 return request_result;
}
esp_err_t rti_session_create_command(rti_session_t *s) {
 ++create_calls;if(create_result==ESP_OK||create_error_with_id)strlcpy(s->session_id,"fake_session",sizeof(s->session_id));
 if(cancel_in_create)assert(group_controller_voice_action(true,NULL)==ESP_OK);
 return create_result;
}
static esp_err_t webrtc_peer_start_command(const rti_session_t *s,const int *a,uint32_t generation,webrtc_command_event_cb_t cb,void *ctx) {
 (void)s;(void)a;++start_calls;
 if(start_result==ESP_OK) {webrtc_command_event_t ready={.type=WEBRTC_COMMAND_READY,.generation=generation};cb(&ready,ctx);}
 return start_result;
}
static void webrtc_peer_stop(void) {++peer_stops;}
esp_err_t rti_session_stop_command(const rti_session_t *s,const char *reason) {
 assert(s->session_id[0]&&reason);++stop_calls;
 if(stop_failures){--stop_failures;return ESP_FAIL;}return ESP_OK;
}
static void random_id(char out[81]) {strlcpy(out,"fixture_operation",81);}
static esp_err_t group_switch_journal_save(const group_switch_journal_t *record) {
 assert(!command_peer_live&&!command_session_live);++journal_saves;saved_record=*record;return ESP_OK;
}
static void reload_switch_journal(void) {assert(!"unexpected journal failure");}
static void finish_unsent_switch(const char *detail) {(void)detail;selection_queued=false;intent.switch_pending=false;}
/* @production-functions */
static void reset(void) {
 memset(&intent,0,sizeof(intent));memset(&command,0,sizeof(command));memset(&config,0,sizeof(config));
 memset(&command_session,0,sizeof(command_session));command_session_live=command_peer_live=false;
 command_deadline_us=command_cleanup_retry_us=0;now_us=1000000;command_target[0]=command_result[0]=0;
 intent.desired=intent.ready=true;catalog_known=true;view_generation=4;
 strlcpy(published_group_id,"grp_aaaa",81);strlcpy(group_id,"grp_aaaa",81);strlcpy(peer_id,"old_group_peer",81);
 strlcpy(config.server_url,"https://fixture.invalid",sizeof(config.server_url));strlcpy(config.device_id,"fixture_device",sizeof(config.device_id));
 published_version=version=7;strlcpy(items[0].id,"grp_aaaa",81);strlcpy(items[1].id,"grp_bbbb",81);catalog_count=2;
 selection_queued=pending_saved=journal_blocked=false;switch_phase=SWITCH_IDLE;
 notifications=disconnects=release_calls=create_calls=start_calls=peer_stops=stop_calls=gate_calls=requests=join_posts=resolve_posts=journal_saves=stop_failures=0;
 create_result=start_result=request_result=ESP_OK;
 create_error_with_id=cancel_in_create=cancel_in_resolve=stop_during_release=stop_after_submit=false;
 strlcpy(resolved_target,"grp_bbbb",81);seen_transcript[0]=last_detail[0]=0;
}
static void begin_voice(void) {
 assert(group_controller_voice_action(false,NULL)==ESP_OK);
 assert(command.kind==GROUP_COMMAND_VOICE&&intent.command_busy&&!intent.ready);
 assert(process_command());assert(command.phase==GROUP_COMMAND_LISTENING);
 assert(disconnects==1&&create_calls==1&&start_calls==1);
}
static void final_event(uint32_t ticket,const char *text) {
 webrtc_command_event_t event={.type=WEBRTC_COMMAND_FINAL,.generation=ticket};strlcpy(event.text,text,sizeof(event.text));command_event(&event,NULL);
}
int main(void) {
 reset();begin_voice();const uint32_t first_ticket=command.ticket;
 final_event(first_ticket,"切到乙群");final_event(first_ticket,"切到甲群");
 assert(command.phase==GROUP_COMMAND_RESOLVING&&strcmp(command.transcript,"切到乙群")==0);
 assert(process_command());assert(resolve_posts==1&&strcmp(seen_transcript,"切到乙群")==0);
 assert(command.phase==GROUP_COMMAND_CLEANUP&&strcmp(command_target,"grp_bbbb")==0);
 // Local capture stops once. The owner waits for a successful remote stop ACK.
 stop_failures=2;assert(process_command());assert(peer_stops==1&&stop_calls==1&&!selection_queued);
 assert(process_command());assert(stop_calls==1);now_us+=2000000;
 assert(process_command());assert(stop_calls==2&&!selection_queued);now_us+=2000000;
 assert(!process_command());assert(stop_calls==3&&command.phase==GROUP_COMMAND_RECOVERING);
 assert(selection_queued&&intent.switch_pending&&command.submitted&&!intent.command_busy);
 assert(selected_expected_version==7&&strcmp(selected_group_id,"grp_bbbb")==0);
 // Production journal handoff keeps the original version and retires media.
 prepare_selected_switch();assert(journal_saves==1&&pending_saved&&!selection_queued);
 assert(saved_record.expected_version==7&&strcmp(saved_record.group_id,"grp_bbbb")==0);
 assert(!process_command()&&command.kind==GROUP_COMMAND_VOICE);
 // Existing journal resolver/connect lifecycle is a separate tested boundary.
 pending_saved=false;intent.switch_pending=false;intent.ready=true;
 assert(!process_command()&&command.kind==GROUP_COMMAND_NONE&&!intent.command_busy);
 uint32_t terminal_revision=command.revision;final_event(first_ticket,"late final");assert(command.revision==terminal_revision);
 reset();assert(group_controller_voice_action(false,NULL)==ESP_OK);
 assert(group_controller_voice_action(true,NULL)==ESP_OK);
 assert(process_command()==false);assert(create_calls==0&&start_calls==0&&resolve_posts==0&&!selection_queued);
 assert(disconnects==1&&peer_id[0]==0); // Cancellation before QUEUED must retire old Peer.
 intent.ready=true;assert(!process_command()&&command.kind==GROUP_COMMAND_NONE);
 reset();cancel_in_create=true;assert(group_controller_voice_action(false,NULL)==ESP_OK);
 assert(process_command());assert(create_calls==1&&start_calls==0);
 assert(!process_command());assert(stop_calls==1&&!selection_queued);
 reset();begin_voice();cancel_in_resolve=true;final_event(command.ticket,"切到乙群");
 assert(process_command());assert(command.cancelled&&command_target[0]==0);
 assert(!process_command());assert(!selection_queued&&stop_calls==1);
 reset();begin_voice();final_event(command.ticket,"切到乙群");assert(process_command());
 intent.desired=false;assert(!process_command());assert(!selection_queued&&!command_session_live);
 assert(!process_command()&&command.kind==GROUP_COMMAND_NONE);
 // A failed create with a known remote handle must retain strict cleanup.
 reset();create_result=ESP_FAIL;create_error_with_id=true;stop_failures=1;
 assert(group_controller_voice_action(false,NULL)==ESP_OK);assert(process_command());
 assert(command.failed&&command_session_live&&start_calls==0);
 assert(process_command());assert(stop_calls==1&&command_session_live&&command.phase==GROUP_COMMAND_CLEANUP);
 now_us+=2000000;assert(!process_command());assert(stop_calls==2&&!command_session_live&&!selection_queued);
 // Without any returned handle, no remote cleanup is possible or fabricated.
 reset();create_result=ESP_FAIL;assert(group_controller_voice_action(false,NULL)==ESP_OK);
 assert(process_command());assert(!command_session_live&&start_calls==0);
 assert(!process_command());assert(stop_calls==0&&!selection_queued);
 // Errors and timeout close both local and remote command resources without a switch.
 reset();start_result=ESP_FAIL;assert(group_controller_voice_action(false,NULL)==ESP_OK);
 assert(process_command());assert(command.failed&&command.phase==GROUP_COMMAND_CLEANUP);
 assert(!process_command());assert(peer_stops==1&&stop_calls==1&&!selection_queued);
 reset();begin_voice();now_us+=46000000;assert(!process_command());
 assert(command.cancelled&&!selection_queued&&peer_stops==1&&stop_calls==1);
 reset();begin_voice();strlcpy(resolved_target,"grp_unknown",81);final_event(command.ticket,"切到未知群");
 assert(process_command());assert(command.failed&&command_target[0]==0);
 assert(!process_command());assert(!selection_queued&&stop_calls==1);
 // A previous command's final cannot satisfy a later command's listener.
 reset();begin_voice();uint32_t old_ticket=command.ticket;
 assert(group_controller_voice_action(true,NULL)==ESP_OK);assert(!process_command());
 intent.ready=true;assert(!process_command());strlcpy(peer_id,"restored_group_peer",81);
 assert(group_controller_voice_action(false,NULL)==ESP_OK);assert(process_command());
 final_event(old_ticket,"切到乙群");assert(command.phase==GROUP_COMMAND_LISTENING);
 assert(group_controller_voice_action(true,NULL)==ESP_OK);assert(!process_command());
 // Join validates/erases copied input; STOP before submit prevents POST.
 reset();assert(group_controller_join_group("abcdefg2",NULL)==ESP_OK);
 assert(command.kind==GROUP_COMMAND_JOIN&&intent.command_busy);
 assert(process_command());assert(join_posts==1&&command.kind==GROUP_COMMAND_NONE&&command.code[0]==0&&!intent.command_busy);
 reset();assert(group_controller_join_group("ABCDEFG2",NULL)==ESP_OK);stop_during_release=true;
 assert(process_command());assert(join_posts==0&&command.kind==GROUP_COMMAND_NONE);
 reset();assert(group_controller_join_group("ABCDEFG2",NULL)==ESP_OK);stop_after_submit=true;
 assert(process_command());assert(join_posts==1&&!intent.desired&&command.kind==GROUP_COMMAND_NONE);
 puts("controller command flow: passed (first final, stop ACK retry, late event, early/in-flight cancel, journal handoff, join STOP)");
 return 0;
}
